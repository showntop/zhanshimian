.wardrobe-page { padding-left: 32rpx; padding-right: 32rpx; }.wardrobe-head { display: grid; grid-template-columns: 1fr auto; gap: 20rpx; align-items: end; }.wardrobe-head > view { display: flex; flex-direction: column; }.wardrobe-count { color: var(--moss); font-size: 22rpx; }.wardrobe-title { margin-top: 8rpx; font-size: 38rpx; font-weight: 700; }.wardrobe-copy { margin-top: 8rpx; color: var(--ink-secondary); font-size: 21rpx; line-height: 1.5; }.wardrobe-head > button { margin: 0; padding: 15rpx 20rpx; border-radius: var(--radius-sm); background: var(--moss); color: #fff; font-size: 21rpx; line-height: 1.2; }
.progress { height: 8rpx; margin-top: 24rpx; overflow: hidden; border-radius: 999rpx; background: #e5e5de; }.progress view { height: 100%; border-radius: inherit; background: var(--moss); transition: width .25s ease; }.category-rail { width: calc(100% + 32rpx); margin: 25rpx -16rpx 0; }.category-row { display: flex; gap: 9rpx; padding: 0 16rpx; }.category-row button { flex: 0 0 auto; margin: 0; padding: 12rpx 20rpx; border-radius: 999rpx; background: #eeeee9; color: var(--ink-secondary); font-size: 20rpx; line-height: 1.2; }.category-row button.active { background: var(--moss); color: #fff; }
.item-grid { margin-top: 24rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 15rpx; }.item-card { position: relative; padding: 12rpx; border-radius: var(--radius-lg); background: var(--surface); border: 1rpx solid var(--line); }.item-card > image { width: 100%; height: 280rpx; border-radius: var(--radius-sm); background: #e5e5e0; }.item-image-empty { width: 100%; height: 280rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; border-radius: var(--radius-sm); background: #e5e5e0; color: var(--ink-tertiary); font-size: 18rpx; }.item-image-empty image { width: 44rpx; height: 44rpx; opacity: .55; }.item-image-empty.outfit-image-empty { width: 150rpx; height: 190rpx; }.delete { position: absolute; right: 19rpx; top: 19rpx; width: 44rpx; height: 44rpx; margin: 0; padding: 0; border-radius: 50%; background: rgba(255,255,255,.9); color: #786d68; font-size: 27rpx; line-height: 44rpx; }.item-name { display: block; margin-top: 12rpx; font-size: 23rpx; font-weight: 650; }.item-meta { display: block; margin-top: 5rpx; color: var(--ink-tertiary); font-size: 18rpx; }.empty { margin-top: 30rpx; padding: 60rpx 24rpx; display: flex; flex-direction: column; align-items: center; gap: 10rpx; }.empty image { width: 52rpx; height: 52rpx; }.empty text:nth-child(2) { font-weight: 700; }.empty text:nth-child(3) { color: var(--ink-tertiary); font-size: 21rpx; }.empty button { margin-top: 14rpx; padding: 14rpx 36rpx; border-radius: var(--radius-md); background: var(--moss); color: #fff; font-size: 21rpx; }.outfit-action { margin-top: 32rpx; }.outfit-action > text { display: block; margin-top: 12rpx; color: var(--ink-tertiary); font-size: 19rpx; text-align: center; }
.sheet-mask { position: fixed; z-index: 90; inset: 0; display: flex; align-items: flex-end; background: rgba(30,34,29,.45); }.add-sheet,.outfit-sheet { width: 100%; padding: 30rpx 32rpx calc(env(safe-area-inset-bottom) + 28rpx); border-radius: var(--radius-xl) var(--radius-xl) 0 0; background: var(--app-bg); }.sheet-head { display: flex; justify-content: space-between; align-items: center; font-weight: 700; }.sheet-head button { margin: 0; padding: 0; background: transparent; color: var(--ink-tertiary); font-size: 18rpx; }.photo-picker { width: 100%; height: 220rpx; margin: 24rpx 0 15rpx; padding: 0; overflow: hidden; border-radius: var(--radius-md); background: #ecece6; color: var(--ink-secondary); font-size: 22rpx; }.photo-picker image { width: 100%; height: 100%; }.add-sheet input { height: 82rpx; margin-top: 12rpx; padding: 0 20rpx; border: 1rpx solid var(--line); border-radius: var(--radius-sm); background: #fff; font-size: 22rpx; }.form-categories { margin: 15rpx 0; display: grid; grid-template-columns: repeat(5,1fr); gap: 7rpx; }.form-categories button { min-width: 0; margin: 0; padding: 15rpx 0; border-radius: var(--radius-sm); background: #eeeee9; color: var(--ink-secondary); font-size: 18rpx; line-height: 1.2; }.form-categories button.active { background: var(--moss); color: #fff; }
.outfit-kicker { color: var(--moss); font-size: 21rpx; }.outfit-title { display: block; margin-top: 10rpx; font-size: 38rpx; font-weight: 700; }.outfit-note { display: block; margin-top: 8rpx; color: var(--ink-secondary); font-size: 21rpx; line-height: 1.5; }.outfit-items { margin: 22rpx 0; display: flex; gap: 10rpx; overflow: hidden; }.outfit-items view { width: 150rpx; flex: 0 0 150rpx; }.outfit-items image { width: 150rpx; height: 190rpx; border-radius: var(--radius-sm); }.outfit-items text { display: block; margin-top: 7rpx; font-size: 18rpx; text-align: center; }
