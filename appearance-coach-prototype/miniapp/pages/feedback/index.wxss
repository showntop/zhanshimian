.feedback-page { padding-bottom: calc(env(safe-area-inset-bottom) + 56rpx); }
.feedback-visual { position: relative; height: 500rpx; overflow: hidden; display: grid; grid-template-columns: 1fr 1fr; border: 1rpx solid var(--line); border-radius: var(--radius-xl); background: #ecebe6; }.feedback-visual > image { width: 100%; height: 100%; }.upload-side { width: 100%; height: 100%; margin: 0; padding: 0; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; color: var(--ink-secondary); border-right: 1rpx solid #fff; background: transparent; }.upload-side image { width: 100%; height: 100%; }.upload-title { font-size: 29rpx; font-weight: 700; }.upload-side text:last-child { font-size: 22rpx; }.reference { position: absolute; right: 18rpx; bottom: 18rpx; padding: 7rpx 12rpx; border-radius: 999rpx; background: rgba(255,255,255,.86); font-size: 20rpx; }
.reference-empty { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; color: var(--ink-tertiary); font-size: 20rpx; }
.reference-empty image { width: 56rpx; height: 56rpx; opacity: .55; }
.feedback-copy { margin: 34rpx 0 24rpx; }.rating-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }.rating-grid button { min-height: 82rpx; margin: 0; border: 1rpx solid var(--line); border-radius: var(--radius-md); background: rgba(255,255,255,.6); color: var(--ink-secondary); font-size: 25rpx; line-height: 82rpx; }.rating-grid button.active { border-color: var(--moss); background: var(--moss-soft); color: var(--moss); font-weight: 600; }
.comment { width: 100%; height: 150rpx; margin: 22rpx 0; padding: 22rpx; font-size: 25rpx; }.success { min-height: calc(100vh - 200rpx - env(safe-area-inset-bottom) - 56rpx); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }.success .eyebrow { margin-top: 28rpx; }.success-title { margin: 22rpx 0; white-space: pre-line; font-size: 54rpx; line-height: 1.28; font-weight: 700; }.success .lede { margin-bottom: 46rpx; }
