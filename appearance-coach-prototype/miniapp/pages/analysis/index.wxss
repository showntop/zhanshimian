.analysis-page { display: flex; flex-direction: column; align-items: center; }
.scan-wrap { position: relative; width: 520rpx; height: 680rpx; margin-top: 30rpx; overflow: hidden; border-radius: 260rpx 260rpx 34rpx 34rpx; background: #e7e8e4; box-shadow: 0 28rpx 80rpx rgba(47,52,45,.12); }
.scan-image { width: 100%; height: 100%; }
.scan-image-face { animation: face-enter .5s ease-out; }
.scan-image-side { animation: side-enter .5s ease-out; }
.scan-image-body { animation: body-enter .5s ease-out; }
@keyframes face-enter { from { opacity: .55; transform: scale(1.035); } }
@keyframes side-enter { from { opacity: .55; transform: translateX(12rpx) scale(1.025); } }
@keyframes body-enter { from { opacity: .55; transform: translateY(12rpx) scale(.985); } }
.scan-empty { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18rpx; color: #7c8379; font-size: 22rpx; }
.scan-empty image { width: 126rpx; height: 126rpx; opacity: .58; }
.scan-mask { position: absolute; inset: 0; border: 1rpx solid rgba(94,122,73,.25); border-radius: inherit; }
.scan-line { position: absolute; left: 11%; right: 11%; top: 24%; height: 2rpx; background: #6d8d57; box-shadow: 0 0 28rpx 12rpx rgba(105,138,82,.2); animation: scan 2s ease-in-out infinite alternate; }
@keyframes scan { to { transform: translateY(300rpx); } }
.focus-point { position: absolute; width: 11rpx; height: 11rpx; margin: -7rpx 0 0 -7rpx; border-radius: 50%; border: 2rpx solid rgba(255,255,255,.95); background: #6f8f59; box-shadow: 0 0 0 7rpx rgba(111,143,89,.13); animation: pulse 1.6s ease-in-out infinite; }
.scan-count { position: absolute; top: 18rpx; left: 50%; padding: 8rpx 14rpx; border-radius: 999rpx; background: rgba(34,39,34,.58); color: #fff; font-size: 19rpx; letter-spacing: 1rpx; white-space: nowrap; transform: translateX(-50%); }
.scan-photo-kind { position: absolute; left: 22rpx; right: 22rpx; bottom: 22rpx; min-height: 46rpx; padding: 9rpx 14rpx; box-sizing: border-box; display: flex; align-items: center; gap: 12rpx; border-radius: 999rpx; background: rgba(255,255,255,.88); color: var(--moss); font-size: 20rpx; font-weight: 600; }
.scan-photo-focus { flex: 1; overflow: hidden; padding-left: 12rpx; border-left: 1rpx solid rgba(88,115,68,.24); color: #72796e; font-size: 18rpx; font-weight: 400; white-space: nowrap; text-overflow: ellipsis; }
@keyframes pulse { 50% { transform: scale(1.28); opacity: .72; } }
.photo-track { width: 100%; margin-top: 24rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.photo-step { flex: 1; min-width: 0; height: 66rpx; padding: 0 14rpx; display: flex; align-items: center; gap: 10rpx; box-sizing: border-box; border: 1rpx solid #e3e5df; border-radius: 18rpx; color: #999e97; background: rgba(255,255,255,.5); }
.photo-step-number { width: 30rpx; height: 30rpx; flex: none; display: flex; align-items: center; justify-content: center; border: 1rpx solid currentColor; border-radius: 50%; font-size: 17rpx; }
.photo-step-copy { min-width: 0; display: flex; flex-direction: column; align-items: flex-start; line-height: 1.25; font-size: 19rpx; }
.photo-step-copy text:last-child { font-size: 17rpx; opacity: .72; }
.photo-step-active { border-color: rgba(88,115,68,.46); color: var(--moss); background: rgba(88,115,68,.1); box-shadow: 0 8rpx 22rpx rgba(88,115,68,.08); }
.photo-step-active .photo-step-copy text:first-child { font-weight: 600; }
.photo-step-done { color: #718565; background: rgba(88,115,68,.045); }
.analysis-copy { width: 100%; margin-top: 28rpx; text-align: center; }
.analysis-title { display: block; margin: 14rpx 0 8rpx; font-size: 35rpx; font-weight: 700; }
.analysis-detail { display: block; min-height: 34rpx; color: #858a83; font-size: 21rpx; }
.progress-head { margin: 24rpx 2rpx 10rpx; display: flex; align-items: center; justify-content: space-between; color: #747873; font-size: 21rpx; }
.progress { height: 7rpx; overflow: hidden; border-radius: 999rpx; background: #e1e2dd; }
.progress-value { height: 100%; border-radius: inherit; background: var(--moss); transition: width .45s ease; }
.stage-row { margin-top: 18rpx; display: flex; justify-content: space-between; color: #a1a49f; font-size: 21rpx; }
.stage-row .done { color: var(--moss); font-weight: 600; }
.retry { margin-top: 34rpx; border: 1rpx solid var(--moss); border-radius: 22rpx; background: transparent; color: var(--moss); }

/* Failure view (photo-gate rejection or generic failure) */
.fail-wrap { width: 100%; box-sizing: border-box; min-height: calc(100vh - 200rpx - env(safe-area-inset-bottom) - 56rpx); padding: 0 56rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.fail-badge { width: 128rpx; height: 128rpx; border-radius: 50%; background: rgba(88,115,68,.1); display: flex; align-items: center; justify-content: center; }
.fail-badge image { width: 72rpx; height: 72rpx; opacity: .75; }
.fail-title { margin: 30rpx 0 6rpx; font-size: 38rpx; font-weight: 700; text-align: center; }
.fail-list { width: 100%; margin-top: 28rpx; border-top: 1rpx solid #eceee8; }
.fail-item { display: flex; align-items: flex-start; gap: 22rpx; padding: 24rpx 4rpx; border-bottom: 1rpx solid #eceee8; }
.fail-kind { flex: none; margin-top: 2rpx; padding: 6rpx 16rpx; border-radius: 999rpx; background: rgba(88,115,68,.1); color: var(--moss); font-size: 21rpx; }
.fail-reason { flex: 1; color: #4c514a; font-size: 26rpx; line-height: 1.6; }
.fail-tip { align-self: flex-start; padding: 20rpx 4rpx 0; color: #a1a49f; font-size: 23rpx; }
.fail-lede { margin-top: 26rpx; color: #747873; font-size: 26rpx; line-height: 1.7; text-align: center; }
.fail-wrap .retry { width: 100%; margin-top: 48rpx; border: none; background: var(--moss); color: #fff; font-weight: 600; }
.fail-wrap .retry::after { border: none; }
