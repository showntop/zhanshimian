.nav { position: fixed; z-index: 40; left: 0; right: 0; bottom: 0; height: calc(env(safe-area-inset-bottom) + 106rpx); padding: 6rpx 82rpx env(safe-area-inset-bottom); display: flex; justify-content: space-between; align-items: center; background: rgba(248,247,243,.94); border-top: 1rpx solid rgba(69,78,64,.1); backdrop-filter: blur(20rpx); }
.nav-item { min-width: 112rpx; height: 88rpx; margin: 0; padding: 9rpx 10rpx 6rpx; display: flex; flex-direction: column; align-items: center; gap: 5rpx; background: transparent; color: #555a55; font-size: 21rpx; line-height: 1; }
.nav-icon { width: 39rpx; height: 39rpx; opacity: .82; }
.nav-item.active { color: var(--moss); font-weight: 600; }
.active-icon { opacity: 1; }
