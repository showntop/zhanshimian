{
  "name": "@zsm/design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "uplook 设计系统单源：tokens.data.mjs → dist/{tokens.wxss, theme.ts} + 小程序语义样式",
  "exports": {
    ".": "./src/index.ts",
    "./styles/*": "./styles/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
