<app-header title="{{failed ? '分析未完成' : '正在分析'}}" back="{{true}}" />
<view class="page analysis-page">
  <block wx:if="{{!failed}}">
    <view class="scan-wrap fade-up">
      <image wx:if="{{previewImage}}" class="scan-image scan-image-{{previewKind}}" src="{{previewImage}}" mode="{{previewMode}}" />
      <view wx:else class="scan-empty"><image src="/assets/capture/face-line.png" mode="aspectFit" /><text>正在准备照片</text></view>
      <view class="scan-mask" />
      <view class="scan-line" />
      <view wx:for="{{scanPoints}}" wx:key="id" class="focus-point" style="left: {{item.x}}%; top: {{item.y}}%; animation-delay: {{item.delay}}ms;" />
      <text class="scan-count">正在分析 {{currentPhotoIndex}} / 3</text>
      <view class="scan-photo-kind"><text>{{previewLabel}}</text><text class="scan-photo-focus">{{analysisSummary}}</text></view>
    </view>
    <view class="photo-track fade-up delay-1">
      <view wx:for="{{photoSteps}}" wx:key="kind" class="photo-step photo-step-{{item.state}}">
        <view class="photo-step-number">{{item.state === 'done' ? '✓' : item.index}}</view>
        <view class="photo-step-copy"><text>{{item.label}}</text><text>{{item.shortFocus}}</text></view>
      </view>
    </view>
    <view class="analysis-copy fade-up delay-1">
      <text class="eyebrow">第 {{currentPhotoIndex}} / 3 张 · {{previewLabel}}</text>
      <text class="analysis-title serif">正在分析{{analysisFocus}}</text>
      <text class="analysis-detail">{{stage}}</text>
      <view class="progress-head"><text>整体分析进度</text><text>{{displayProgress}}%</text></view>
      <view class="progress"><view class="progress-value" style="width: {{progress}}%" /></view>
      <view class="stage-row"><text class="{{progress >= 22 ? 'done' : ''}}">读取轮廓</text><text class="{{progress >= 48 ? 'done' : ''}}">匹配方向</text><text class="{{progress >= 82 ? 'done' : ''}}">生成方案</text></view>
    </view>
  </block>
  <view wx:else class="fail-wrap fade-up">
    <view class="fail-badge"><image src="/assets/capture/face-line.png" mode="aspectFit" /></view>
    <text class="fail-title serif">{{failTitle}}</text>
    <view wx:if="{{failureItems.length}}" class="fail-list">
      <view wx:for="{{failureItems}}" wx:key="label" class="fail-item">
        <text class="fail-kind">{{item.label}}</text>
        <text class="fail-reason">{{item.reason}}</text>
      </view>
      <text class="fail-tip">{{failTip}}</text>
    </view>
    <text wx:else class="fail-lede">{{failMessage}}</text>
    <button class="retry" bindtap="retry">{{failAction}}</button>
  </view>
</view>
