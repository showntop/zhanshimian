<app-header title="实际反馈" back="{{true}}" />
<view class="page feedback-page">
  <view wx:if="{{!done}}">
    <view class="feedback-visual fade-up"><button class="upload-side" bindtap="choosePhoto"><image wx:if="{{feedbackImage}}" src="{{feedbackImage}}" mode="aspectFill" /><block wx:else><text class="upload-title serif">上传今天的实拍</text><text>可选 · 仅自己可见</text></block></button><image src="/assets/looks/sharp.jpg" mode="aspectFill" /><text class="reference">方案参考</text></view>
    <view class="feedback-copy fade-up delay-1"><text class="eyebrow">这套方案在现实中怎么样？</text><text class="title">你的感受比 AI 判断更重要</text></view>
    <view class="rating-grid fade-up delay-2"><button wx:for="{{tags}}" wx:key="label" class="{{item.active ? 'active' : ''}}" data-tag="{{item.label}}" bindtap="toggle">{{item.label}}</button></view>
    <textarea class="comment surface" maxlength="500" placeholder="还有什么想告诉我？（选填）" value="{{comment}}" bindinput="input" />
    <primary-button text="提交反馈" loading="{{loading}}" disabled="{{!selected.length}}" bind:tap="submit" />
  </view>
  <view wx:else class="success fade-up"><icon type="success" size="58" color="#587344" /><text class="eyebrow">第一次闭环完成</text><text class="success-title serif">我们记住了
什么对你有效</text><text class="lede">下一次推荐会优先保留这套方案的轮廓与配色，并根据你的实际反馈继续调整。</text><primary-button text="回到首页" bind:tap="home" /></view>
</view>
