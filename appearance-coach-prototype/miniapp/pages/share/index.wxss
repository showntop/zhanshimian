.share-page { padding-left: 44rpx; padding-right: 44rpx; }.poster { overflow: hidden; padding: 34rpx; border: 1rpx solid var(--line); border-radius: var(--radius-xl); background: var(--surface-strong); box-shadow: 0 12rpx 36rpx rgba(42,50,38,.08); }
.poster-brand { display: flex; align-items: baseline; justify-content: space-between; }.poster-brand text:first-child { font-family: "Songti SC",serif; font-size: 38rpx; font-weight: 700; color: var(--ink); }.poster-brand text:last-child { color: var(--ink-tertiary); font-size: 19rpx; letter-spacing: 2rpx; }
.poster-label { display: block; margin-top: 52rpx; color: var(--moss); font-size: 21rpx; }.poster-title { display: block; margin-top: 14rpx; font-size: 44rpx; line-height: 1.25; font-weight: 700; }.poster-summary { display: block; margin-top: 14rpx; color: var(--ink-secondary); font-size: 22rpx; line-height: 1.6; }
.poster image { width: 100%; height: 530rpx; margin-top: 28rpx; border-radius: var(--radius-md); background: #e2e3de; }.poster-tags { margin-top: 22rpx; display: grid; grid-template-columns: repeat(3,1fr); gap: 10rpx; }.poster-tags text { padding: 13rpx; border-radius: 999rpx; background: #f0efe9; color: var(--ink-secondary); text-align: center; font-size: 20rpx; }.poster-foot { margin-top: 28rpx; padding-top: 20rpx; display: flex; justify-content: space-between; border-top: 1rpx solid var(--line); color: var(--ink-tertiary); font-size: 17rpx; }
.share-actions { margin-top: 24rpx; display: grid; gap: 12rpx; }.share-actions button { margin: 0; border-radius: var(--radius-md); background: #eeeee9; color: var(--ink); font-size: 24rpx; }.share-actions .primary { background: var(--moss); color: #fff; }.share-actions .revoke { background: transparent; color: #9a5d56; font-size: 20rpx; }.loading { height: 900rpx; border-radius: var(--radius-xl); }.export-canvas { position: fixed; left: -2000px; top: 0; width: 620rpx; height: 900rpx; }
.load-error { margin-top: 30rpx; padding: 60rpx 24rpx; display: flex; flex-direction: column; align-items: center; gap: 10rpx; }.load-error text { color: var(--ink-tertiary); font-size: 21rpx; }.load-error text:first-child { color: var(--ink); font-weight: 700; }.load-error button { margin-top: 14rpx; padding: 14rpx 36rpx; border-radius: var(--radius-md); background: var(--moss); color: #fff; font-size: 21rpx; }
