.wardrobe-page { padding-left: 32rpx; padding-right: 32rpx; }.wardrobe-head { display: grid; grid-template-columns: 1fr auto; gap: 20rpx; align-items: end; }.wardrobe-head > view { display: flex; flex-direction: column; }.wardrobe-count { color: #587344; font-size: 22rpx; }.wardrobe-title { margin-top: 8rpx; font-size: 38rpx; font-weight: 700; }.wardrobe-copy { margin-top: 8rpx; color: #7b817a; font-size: 21rpx; line-height: 1.5; }.wardrobe-head > button { margin: 0; padding: 15rpx 20rpx; border-radius: 16rpx; background: #587344; color: #fff; font-size: 21rpx; line-height: 1.2; }
.progress { height: 8rpx; margin-top: 24rpx; overflow: hidden; border-radius: 99rpx; background: #e5e5de; }.progress view { height: 100%; border-radius: inherit; background: #587344; transition: width .25s ease; }.category-rail { width: calc(100% + 32rpx); margin: 25rpx -16rpx 0; }.category-row { display: flex; gap: 9rpx; padding: 0 16rpx; }.category-row button { flex: 0 0 auto; margin: 0; padding: 12rpx 20rpx; border-radius: 999rpx; background: #eeeee9; color: #6d736c; font-size: 20rpx; line-height: 1.2; }.category-row button.active { background: #587344; color: #fff; }
.item-grid { margin-top: 24rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 15rpx; }.item-card { position: relative; padding: 12rpx; border-radius: 23rpx; background: rgba(255,255,255,.78); border: 1rpx solid var(--line); }.item-card > image { width: 100%; height: 280rpx; border-radius: 16rpx; background: #e5e5e0; }.delete { position: absolute; right: 19rpx; top: 19rpx; width: 44rpx; height: 44rpx; margin: 0; padding: 0; border-radius: 50%; background: rgba(255,255,255,.9); color: #786d68; font-size: 27rpx; line-height: 44rpx; }.item-name { display: block; margin-top: 12rpx; font-size: 23rpx; font-weight: 650; }.item-meta { display: block; margin-top: 5rpx; color: #858a84; font-size: 18rpx; }.empty { margin-top: 30rpx; padding: 60rpx 24rpx; display: flex; flex-direction: column; align-items: center; gap: 10rpx; }.empty image { width: 52rpx; height: 52rpx; }.empty text:nth-child(2) { font-weight: 700; }.empty text:nth-child(3) { color: #858a84; font-size: 21rpx; }.empty button { margin-top: 14rpx; background: #eef2e9; color: #587344; font-size: 21rpx; }.outfit-action { margin-top: 32rpx; }.outfit-action > text { display: block; margin-top: 12rpx; color: #858a84; font-size: 19rpx; text-align: center; }
.sheet-mask { position: fixed; z-index: 90; inset: 0; display: flex; align-items: flex-end; background: rgba(30,34,29,.45); }.add-sheet,.outfit-sheet { width: 100%; padding: 30rpx 32rpx calc(env(safe-area-inset-bottom) + 28rpx); border-radius: 32rpx 32rpx 0 0; background: #f8f7f3; }.sheet-head { display: flex; justify-content: space-between; align-items: center; font-weight: 700; }.sheet-head button { margin: 0; padding: 0; background: transparent; color: #858a84; font-size: 18rpx; }.photo-picker { width: 100%; height: 220rpx; margin: 24rpx 0 15rpx; padding: 0; overflow: hidden; border-radius: 21rpx; background: #ecece6; color: #587344; font-size: 22rpx; }.photo-picker image { width: 100%; height: 100%; }.add-sheet input { height: 82rpx; margin-top: 12rpx; padding: 0 20rpx; border: 1rpx solid var(--line); border-radius: 17rpx; background: #fff; font-size: 22rpx; }.form-categories { margin: 15rpx 0; display: grid; grid-template-columns: repeat(5,1fr); gap: 7rpx; }.form-categories button { min-width: 0; margin: 0; padding: 15rpx 0; border-radius: 13rpx; background: #eeeee9; color: #6e746d; font-size: 18rpx; line-height: 1.2; }.form-categories button.active { background: #587344; color: #fff; }
.outfit-kicker { color: #587344; font-size: 21rpx; }.outfit-title { display: block; margin-top: 10rpx; font-size: 38rpx; font-weight: 700; }.outfit-note { display: block; margin-top: 8rpx; color: #787e77; font-size: 21rpx; line-height: 1.5; }.outfit-items { margin: 22rpx 0; display: flex; gap: 10rpx; overflow: hidden; }.outfit-items view { width: 150rpx; flex: 0 0 150rpx; }.outfit-items image { width: 150rpx; height: 190rpx; border-radius: 17rpx; }.outfit-items text { display: block; margin-top: 7rpx; font-size: 18rpx; text-align: center; }
