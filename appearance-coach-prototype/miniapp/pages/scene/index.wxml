<app-header title="场合需求" back="{{true}}" />
<view class="page scene-page">
  <view class="scene-summary fade-up">
    <view class="scene-mark"><image src="{{scene.icon}}" /></view>
    <view><text class="summary-label">{{scene.label}}方案</text><text class="summary-copy">{{briefCopy}}</text></view>
    <text class="profile-reuse">{{hasProfile ? '复用档案' : '稍后建档'}}</text>
  </view>

  <view class="brief-card fade-up delay-1">
    <view wx:for="{{questions}}" wx:key="key" wx:for-item="question" class="question-block {{question.last ? 'last' : ''}}">
      <view class="question-head"><text>{{question.label}}</text><text>{{question.position}}</text></view>
      <view class="choice-grid {{question.grid}}">
        <button wx:for="{{question.options}}" wx:for-item="option" wx:key="value" class="choice {{option.active ? 'active' : ''}}" data-field="{{question.key}}" data-value="{{option.value}}" bindtap="selectOne">{{option.label}}</button>
      </view>
    </view>
  </view>

  <view class="reuse-note fade-up delay-2"><image src="/assets/icons/shield-check.png" /><text>{{hasProfile ? '不会重复索要照片和身体数据' : '完成选择后只需建立一次形象档案'}}</text></view>
  <view class="scene-action fade-up delay-2"><primary-button text="{{hasProfile ? '生成' + scene.label + '方案' : '下一步：建立形象档案'}}" loading="{{creating}}" bind:tap="continueFlow" /></view>
</view>
