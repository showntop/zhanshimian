# Copy to server/.env on the deployment host, then fill every <...> value.
APP_ENV=production
ADDR=:8080
DATABASE_URL=postgres://<db-user>:<db-password>@<docker-network-db-host>:5432/jianwo?sslmode=require
PUBLIC_BASE_URL=https://prompt.wuyill.com/zhanshimian
UPLOAD_DIR=data/uploads
ASSET_DIR=assets
DEV_LOGIN_ENABLED=false
RUN_WORKER=true

WECHAT_APP_ID=wx911e0fbcba0b24d0
WECHAT_APP_SECRET=<wechat-app-secret>
WECHAT_API_BASE_URL=https://api.weixin.qq.com/sns/jscode2session
WECHAT_REQUEST_TIMEOUT_SECONDS=5

STORAGE_PROVIDER=cos
ASSET_URL_TTL_SECONDS=900
ASSET_BUCKET=wuyill-1252214184
ASSET_S3_ENDPOINT=https://cos.ap-beijing.myqcloud.com
ASSET_REGION=ap-beijing
# COS_BUCKET_URL is derived from ASSET_BUCKET + ASSET_S3_ENDPOINT.
COS_BUCKET_URL=
COS_SECRET_ID=<tencent-cloud-secret-id>
COS_SECRET_KEY=<tencent-cloud-secret-key>
COS_KEY_PREFIX=zhanshimian/production

WEATHER_PROVIDER=amap
WEATHER_REQUEST_TIMEOUT_SECONDS=5
AMAP_WEB_SERVICE_KEY=<amap-web-service-key>
AMAP_API_BASE_URL=https://restapi.amap.com/v3/weather/weatherInfo
AMAP_DEFAULT_CITY=上海
AMAP_DEFAULT_ADCODE=310000

# Unified real-model routing. Mount the committed production catalog
# (includes lab-only body_orbit → demo/body-orbit). No extra API key needed.
AI_ROUTING_FILE=/app/config/ai-routing.json
AI_ROUTING_HOST_FILE=./apps/server/config/ai-routing.production.json
ALIYUN_API_KEY=<aliyun-bailian-api-key>
VOLCENGINE_API_KEY=<volcengine-ark-api-key>
BAILIAN_WORKSPACE_ID=<bailian-workspace-id>

# Legacy provider switches are ignored while AI_ROUTING_FILE is set.
