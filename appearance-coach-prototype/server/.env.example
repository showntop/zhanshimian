ADDR=:8080
# Docker Compose uses the postgres service name. For direct host execution,
# override this with postgres://jianwo:jianwo@localhost:54329/jianwo?sslmode=disable.
DATABASE_URL=postgres://jianwo:jianwo@postgres:5432/jianwo?sslmode=disable
PUBLIC_BASE_URL=http://localhost:8080
UPLOAD_DIR=data/uploads
ASSET_DIR=assets
DEV_LOGIN_ENABLED=true
RUN_WORKER=true

# AI_PROVIDER=demo keeps the repository self-contained. Set openai for real photo analysis.
AI_PROVIDER=demo
AI_FALLBACK_TO_DEMO=true
AI_REQUEST_TIMEOUT_SECONDS=90
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-5-mini

# Hair preview runs as an independent async image-editing task.
HAIR_PREVIEW_PROVIDER=demo
HAIR_PREVIEW_FALLBACK_TO_DEMO=true
HAIR_PREVIEW_TIMEOUT_SECONDS=150
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

# Single-photo structured outfit diagnosis.
OUTFIT_DIAGNOSIS_PROVIDER=demo
OUTFIT_DIAGNOSIS_FALLBACK_TO_DEMO=true
OUTFIT_DIAGNOSIS_TIMEOUT_SECONDS=60
OPENAI_OUTFIT_MODEL=gpt-5-mini
