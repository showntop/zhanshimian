.share-page { padding-left: 44rpx; padding-right: 44rpx; }.poster { overflow: hidden; padding: 34rpx; border-radius: 32rpx; background: linear-gradient(150deg,#fbfaf6,#eef2e9); border: 1rpx solid rgba(86,114,67,.18); box-shadow: 0 20rpx 56rpx rgba(42,50,38,.11); }
.poster-brand { display: flex; align-items: baseline; justify-content: space-between; color: #587344; }.poster-brand text:first-child { font-family: "Songti SC",serif; font-size: 38rpx; font-weight: 700; }.poster-brand text:last-child { font-size: 19rpx; letter-spacing: 2rpx; }
.poster-label { display: block; margin-top: 52rpx; color: #587344; font-size: 21rpx; }.poster-title { display: block; margin-top: 14rpx; font-size: 44rpx; line-height: 1.25; font-weight: 700; }.poster-summary { display: block; margin-top: 14rpx; color: #6f766e; font-size: 22rpx; line-height: 1.6; }
.poster image { width: 100%; height: 530rpx; margin-top: 28rpx; border-radius: 23rpx; background: #e2e3de; }.poster-tags { margin-top: 22rpx; display: grid; grid-template-columns: repeat(3,1fr); gap: 10rpx; }.poster-tags text { padding: 13rpx; border-radius: 999rpx; background: rgba(255,255,255,.72); color: #587344; text-align: center; font-size: 20rpx; }.poster-foot { margin-top: 28rpx; padding-top: 20rpx; display: flex; justify-content: space-between; border-top: 1rpx solid rgba(86,114,67,.15); color: #858a84; font-size: 17rpx; }
.share-actions { margin-top: 24rpx; display: grid; gap: 12rpx; }.share-actions button { margin: 0; border-radius: 18rpx; background: #eeeee9; color: #587344; font-size: 24rpx; }.share-actions .primary { background: #587344; color: #fff; }.share-actions .revoke { background: transparent; color: #9a5d56; font-size: 20rpx; }.loading { height: 900rpx; border-radius: 30rpx; }.export-canvas { position: fixed; left: -2000px; top: 0; width: 620rpx; height: 900rpx; }
