<app-header transparent="{{true}}" />
<scroll-view class="home-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="home">
    <view class="advisor-head {{initialized ? 'fade-up' : ''}}">
      <view>
        <text class="advisor-kicker">私人形象顾问</text>
        <text class="advisor-greeting">{{hasProfile ? greeting + '，今日造型穿搭建议' : '你好，我是你的私人形象顾问'}}</text>
      </view>
    </view>

    <view class="profile-card first-card {{initialized ? 'fade-up delay-1' : ''}}" hidden="{{hasProfile}}">
      <view class="card-topline"><text>形象档案</text><text>约 3 分钟</text></view>
      <text class="profile-title">先让我认识真实的你</text>
      <text class="profile-subtitle">上传 3 张照片，获得当前形象分析和 3 套本人方案</text>
      <view class="photo-types">
        <view class="photo-type"><view class="photo-icon"><image src="/assets/capture/face-line.png" mode="aspectFill" /></view><text>正脸</text></view>
        <view class="photo-connector" />
        <view class="photo-type"><view class="photo-icon"><image src="/assets/capture/side-line.png" mode="aspectFill" /></view><text>侧脸</text></view>
        <view class="photo-connector" />
        <view class="photo-type"><view class="photo-icon"><image src="/assets/capture/body-line.png" mode="aspectFill" /></view><text>全身</text></view>
      </view>
      <primary-button text="开始形象分析" bind:tap="start" />
      <view class="privacy-line"><image src="/assets/icons/shield-check.png" /><text>照片可随时删除，仅用于生成分析</text></view>
    </view>

    <view class="today-card {{initialized ? 'fade-up delay-1' : ''}}" hidden="{{!hasProfile}}">
      <view class="today-card-head">
        <view class="weather-line" wx:if="{{todayContext}}"><image src="/assets/icons/sun.png" /><text>{{todayContext.city}} · {{todayContext.condition}} · {{todayContext.temperature}}°C</text></view>
        <text class="day-kind" wx:if="{{todayContext}}">{{todayContext.day_type}} · {{todayContext.schedule}}</text>
      </view>
      <view class="today-body">
        <view class="today-details">
          <text class="today-title">{{todayPlan ? todayPlan.title : '今天的造型建议还没生成'}}</text>
          <block wx:if="{{todayPlan}}">
            <view class="style-detail"><text class="detail-label">发型</text><text>{{todayPlan.steps[0].title}}</text></view>
            <view class="style-detail"><text class="detail-label">妆造</text><text>{{todayPlan.steps[1].title}}</text></view>
            <view class="style-detail"><text class="detail-label">穿搭</text><text>{{todayPlan.steps[2].title}}</text></view>
          </block>
          <text wx:else class="today-pending-copy">结合今天的天气和你的形象档案，生成可直接执行的发型、妆容与穿搭。</text>
        </view>
        <button class="today-thumb-wrap pressable" bindtap="previewTodayLook" aria-label="查看今日穿搭大图">
          <image wx:if="{{todayLookUrl}}" class="today-thumb {{todayLookExample ? 'example-soft' : ''}}" src="{{todayLookUrl}}" mode="aspectFill" />
          <view wx:else class="today-thumb-empty"><image src="/assets/capture/body-line.png" mode="aspectFit" /><text>效果生成中</text></view>
          <text wx:if="{{todayLookExample}}" class="example-badge" style="bottom: 36rpx">风格参考</text>
          <text wx:if="{{todayLookUrl}}" class="today-thumb-hint">点开看大图</text>
        </button>
      </view>
      <button class="today-action pressable" loading="{{todayOpening}}" disabled="{{todayOpening}}" bindtap="openToday">{{todayOpening ? '正在打开今日方案…' : (todayPlan ? '查看今日完整方案' : '生成我的今日方案')}} <text wx:if="{{!todayOpening}}">›</text></button>
    </view>

    <view class="task-stack {{initialized ? 'fade-up delay-1' : ''}}" hidden="{{!tasks.length}}">
      <button wx:for="{{tasks}}" wx:key="kind" class="task-banner pressable" data-index="{{index}}" bindtap="openTask">
        <view class="task-state {{item.state}}"><view wx:if="{{item.state === 'queued' || item.state === 'processing'}}" class="task-spinner" /><icon wx:elif="{{item.state === 'completed'}}" type="success_no_circle" size="18" color="#ffffff" /><text wx:else>!</text></view>
        <view class="task-copy"><text>{{item.title}}</text><text>{{item.note}}</text></view><text class="task-action">{{item.action}} ›</text>
      </button>
    </view>

    <view class="product-section scene-section {{initialized ? 'fade-up delay-2' : ''}}" hidden="{{!hasProfile}}">
      <view class="section-head"><view><text class="section-heading">你准备去哪里？</text><text class="section-note">选一个场合，我来组合适合你的方案</text></view></view>
      <view class="scene-grid">
        <button wx:for="{{scenes}}" wx:key="id" class="scene-item pressable" data-scene="{{item.id}}" bindtap="chooseScene">
          <view class="scene-icon"><image src="{{item.icon}}" mode="aspectFit" /></view>
          <text class="scene-name">{{item.label}}</text>
          <text class="scene-note">{{item.note}}</text>
        </button>
      </view>
    </view>

    <view class="product-section result-section {{initialized ? 'fade-up delay-2' : ''}}">
      <view class="section-head"><view><text class="section-heading">{{hasProfile ? '最近方案' : '你会得到什么'}}</text><text class="section-note">当前与方案一眼对比</text></view><button wx:if="{{hasProfile}}" class="text-action" bindtap="openExample">全部方案</button></view>
      <view class="comparison-card">
        <view class="comparison-images">
          <button class="comparison-half pressable" bindtap="openReport">
            <image class="comparison-fill" src="{{hasProfile ? (currentLookUrl || '') : '/assets/reports/natural.jpg'}}" mode="widthFix" hidden="{{hasProfile && !currentLookUrl}}" />
            <view class="comparison-image-empty" hidden="{{!(hasProfile && !currentLookUrl)}}"><image class="comparison-empty-icon" src="/assets/capture/face-line.png" mode="aspectFit" /><text>当前照片</text></view>
            <text class="image-chip">{{hasProfile ? '当前 · 报告 ›' : '示例'}}</text>
          </button>
          <button class="comparison-half plan-half pressable" bindtap="openExample">
            <view wx:if="{{hasProfile && !referenceGenerated && !referenceDemo}}" class="comparison-image-empty"><image class="comparison-empty-icon" src="/assets/capture/body-line.png" mode="aspectFit" /><text>生成本人方案后可对比</text></view>
            <block wx:else>
              <image class="comparison-fill" src="{{hasProfile ? referenceLookUrl : '/assets/reports/sharp.jpg'}}" mode="widthFix" />
              <text class="image-chip plan-chip">{{hasProfile ? (referenceDemo ? '流程预览' : '本人方案') : '风格参考'}}</text>
            </block>
          </button>
          <view class="comparison-arrow" bindtap="openExample">→</view>
        </view>
        <button class="comparison-footer pressable" bindtap="openExample"><view class="comparison-copy"><text class="comparison-title">{{comparisonTitle || '当前 / 方案'}}</text><text class="comparison-sub">{{hasProfile && !referenceGenerated && !referenceDemo ? '生成后可在这里一眼对比' : '发型 · 妆容 · 穿搭已组合'}}</text></view><text class="example-link">查看 ›</text></button>
      </view>
    </view>

    <view class="product-section tool-section {{initialized ? 'fade-up delay-3' : ''}}" hidden="{{!hasProfile}}">
      <view class="section-head"><view><text class="section-heading">快捷工具</text><text class="section-note">处理今天眼前的一件事</text></view></view>
      <scroll-view class="tool-rail" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="tool-row">
          <button wx:for="{{tools}}" wx:key="id" class="tool-card pressable" data-tool="{{item.id}}" bindtap="openTool">
            <view class="tool-icon"><image src="{{item.icon}}" mode="aspectFit" /></view>
            <view><text class="tool-name">{{item.label}}</text><text class="tool-note">{{item.note}}</text></view>
            <text wx:if="{{item.badge}}" class="tool-badge">{{item.badge}}</text>
          </button>
        </view>
      </scroll-view>
    </view>

  </view>
</scroll-view>
<view wx:if="{{previewOpen}}" class="look-lightbox" catchtap="closeTodayLook">
  <view class="look-lightbox-inner">
    <image class="look-lightbox-image" src="{{todayLookUrl}}" mode="aspectFit" />
    <text class="look-lightbox-note">点击任意处关闭</text>
  </view>
</view>
