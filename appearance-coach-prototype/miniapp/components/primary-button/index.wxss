.primary { width: 100%; min-height: 96rpx; margin: 0; padding: 0 32rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-md); background: var(--moss); color: #fff; font-size: 29rpx; font-weight: 600; letter-spacing: 0; box-shadow: 0 12rpx 28rpx rgba(75,100,57,.16); transition: transform .16s ease, background .16s ease; }
.primary-hover { transform: scale(.985); background: var(--moss-pressed); }
.primary.disabled { background: #cdd3c8; color: rgba(255,255,255,.86); box-shadow: none; }
