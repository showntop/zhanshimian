<app-header title="形象分析报告" back="{{true}}" />
<view class="page report-page">
  <view wx:if="{{loading}}" class="loading-view"><view class="skeleton skeleton-title" /><view class="skeleton skeleton-photo" /></view>
  <block wx:else-if="{{report}}">
    <view class="status fade-up"><icon type="success" size="18" color="#587344" /><text>分析完成 · 已保存至形象档案</text></view>
    <text class="report-title serif fade-up">你的形象特点，已经看清楚了</text>
    <view class="current-card fade-up delay-1">
      <smart-image wx:if="{{image}}" className="current-photo" src="{{image}}" placeholder="/assets/placeholders/figure.png" mode="aspectFill" />
      <view wx:else class="image-unavailable"><image src="/assets/capture/face-line.png" mode="aspectFit" /><text>当前照片加载中</text></view>
      <text class="current-label">当前形象</text>
      <view wx:for="{{annotations}}" wx:key="id" class="finding {{item.alignClass}}" style="left: {{item.styleLeft}}; top: {{item.styleTop}};"><text class="number">{{index + 1}}</text><text>{{item.label}}</text><view class="connector" /></view>
    </view>
    <view class="impression fade-up delay-2">
      <text class="impression-title serif">你的当前印象</text>
      <view class="pill-row"><text wx:for="{{report.impression_tags}}" wx:key="*this" class="pill">{{item}}</text></view>
    </view>
    <view class="priority surface fade-up delay-2">
      <view class="priority-star"><image src="/assets/icons/sparkles.svg" /></view>
      <view class="priority-content"><text class="priority-label">最值得先改的一处</text><text class="priority-title serif">{{report.priority_title}}</text><text class="priority-copy">{{report.priority_copy}}</text></view>
    </view>
    <view wx:if="{{findingItems.length}}" class="details fade-up delay-2">
      <text class="section-title">细致解读</text>
      <view wx:for="{{findingItems}}" wx:key="id" class="detail-row">
        <view class="detail-head">
          <text class="detail-number">{{item.index}}</text>
          <text class="detail-label">{{item.label}}</text>
          <text class="detail-chip">{{item.categoryLabel}}</text>
          <text wx:if="{{item.severityLabel}}" class="detail-severity severity-{{item.severity}}">{{item.severityLabel}}</text>
        </view>
        <text wx:if="{{item.detail}}" class="detail-copy">{{item.detail}}</text>
      </view>
    </view>
    <view wx:if="{{suggestions.length}}" class="suggestions fade-up delay-3">
      <text class="section-title">给你的 3 个建议</text>
      <view wx:for="{{suggestions}}" wx:key="category" class="suggestion-row" bindtap="viewPlans">
        <image src="{{item.icon}}" /><text class="suggestion-type">{{item.type}}</text><text class="suggestion-copy">{{item.title}}，{{item.summary}}</text><text class="chevron">〉</text>
      </view>
    </view>
    <view class="report-action"><primary-button text="{{ctaText}}" loading="{{generating}}" disabled="{{generating}}" bind:tap="viewPlans" /><button class="reanalyze-action" bindtap="reanalyze">重新上传 3 张照片并更新分析</button></view>
  </block>
</view>
