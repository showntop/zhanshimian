.report-page { padding-bottom: calc(env(safe-area-inset-bottom) + 56rpx); }

/* loading / error / empty 共用的居中内容区，不用 margin 硬推 */
.state-view { min-height: calc(100vh - 200rpx - env(safe-area-inset-bottom) - 56rpx); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18rpx; text-align: center; }
.state-title { color: var(--ink); font-size: 34rpx; font-weight: 700; }
.state-copy { max-width: 540rpx; color: var(--ink-secondary); font-size: 24rpx; line-height: 1.65; }
.state-action { width: 100%; max-width: 440rpx; margin-top: 18rpx; }

.skeleton-photo { width: 100%; height: 860rpx; border-radius: var(--radius-xl); }
.skeleton-line { width: 68%; height: 28rpx; border-radius: var(--radius-sm); }
.skeleton-line.short { width: 42%; }

/* 照片标注卡：图片按宽度完整显示（widthFix），超高照片只裁底部，保住头肩部锚点精度 */
.current-card { position: relative; max-height: 980rpx; overflow: hidden; border-radius: var(--radius-xl); background: #e8e7e3; box-shadow: 0 14rpx 38rpx rgba(48,51,47,.07); }
.current-card > image { width: 100%; display: block; }
.image-unavailable { width: 100%; min-height: 560rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; color: var(--ink-tertiary); font-size: 22rpx; }
.image-unavailable image { width: 112rpx; height: 112rpx; opacity: .58; }
.current-label { position: absolute; top: 18rpx; left: 18rpx; z-index: 3; padding: 9rpx 15rpx; border-radius: var(--radius-sm); background: rgba(255,255,255,.9); color: var(--ink); font-size: 22rpx; }
.finding-dot { position: absolute; z-index: 2; width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--moss); border-radius: 50%; background: rgba(251,250,247,.95); color: var(--moss); font-size: 20rpx; transform: translate(-50%, -50%); box-shadow: 0 4rpx 10rpx rgba(45,52,42,.18); }
.finding-line { position: absolute; z-index: 1; width: 2rpx; height: 12rpx; background: rgba(251,250,247,.85); transform: translateX(-50%); }
.finding-chip { position: absolute; z-index: 2; max-width: 300rpx; padding: 8rpx 14rpx; display: flex; align-items: center; gap: 8rpx; border: 1rpx solid var(--line); border-radius: var(--radius-sm); background: rgba(251,250,247,.94); box-shadow: 0 6rpx 16rpx rgba(45,52,42,.12); }
.finding-chip-number { flex: none; color: var(--moss); font-size: 20rpx; font-weight: 600; }
.finding-chip-label { color: var(--ink); font-size: 21rpx; line-height: 1.35; }

/* 当前印象 */
.impression { margin: 28rpx 4rpx; display: flex; align-items: flex-start; gap: 18rpx; flex-wrap: wrap; }
.impression-title { flex: none; font-size: 31rpx; font-weight: 700; white-space: nowrap; }
.impression .pill-row { flex: 1; min-width: 0; justify-content: flex-start; flex-wrap: wrap; gap: 12rpx; }
.impression .pill { padding: 12rpx 18rpx; white-space: nowrap; }

/* 优先改进：纯文字层级 */
.priority { margin-top: 8rpx; padding: 30rpx 28rpx; display: flex; flex-direction: column; gap: 12rpx; }
.priority-label { color: var(--ink-tertiary); font-size: 22rpx; letter-spacing: 2rpx; }
.priority-title { color: var(--ink); font-size: 36rpx; line-height: 1.3; font-weight: 700; }
.priority-copy { color: var(--ink-secondary); font-size: 24rpx; line-height: 1.65; }

/* 细致解读：去卡片，行间 hairline 分隔 */
.details .section-title { display: block; }
.detail-row { padding: 22rpx 4rpx 24rpx; border-bottom: 1rpx solid var(--line); }
.detail-row:last-child { border-bottom: 0; }
.detail-head { display: flex; align-items: center; gap: 12rpx; }
.detail-number { flex: none; width: 32rpx; height: 32rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--moss); border-radius: 50%; color: var(--moss); font-size: 18rpx; }
.detail-label { flex: 1; color: var(--ink); font-size: 25rpx; font-weight: 600; }
.detail-chip { flex: none; padding: 5rpx 14rpx; border-radius: 999rpx; background: #efeee9; color: var(--ink-secondary); font-size: 19rpx; }
.detail-severity { flex: none; color: var(--ink-tertiary); font-size: 19rpx; }
.detail-severity.severity-medium { color: var(--moss); }
.detail-severity.severity-high { color: #a9683c; }
.detail-copy { display: block; margin-top: 12rpx; color: var(--ink-secondary); font-size: 23rpx; line-height: 1.65; }

/* 建议列表：去卡片，行间 hairline 分隔 */
.suggestions .section-title { display: block; }
.suggestion-row { min-height: 96rpx; padding: 18rpx 4rpx; display: grid; grid-template-columns: 90rpx 1fr 34rpx; align-items: center; gap: 16rpx; border-bottom: 1rpx solid var(--line); font-size: 23rpx; transition: opacity .16s ease; }
.suggestion-row:last-child { border-bottom: 0; }
.suggestion-row-hover { opacity: .55; }
.suggestion-type { color: var(--ink); font-weight: 600; }
.suggestion-copy { color: var(--ink-secondary); line-height: 1.5; }
.chevron { color: var(--ink-tertiary); font-size: 30rpx; text-align: right; }
.suggestions-error { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 22rpx 4rpx; color: var(--ink-secondary); font-size: 23rpx; }
.suggestions-retry { flex: none; margin: 0; padding: 8rpx 30rpx; border: 1rpx solid var(--line); border-radius: 999rpx; background: transparent; color: var(--ink); font-size: 22rpx; line-height: 1.7; }

.report-action { margin-top: 40rpx; }
.reanalyze-action { width: 100%; margin: 12rpx 0 0; padding: 18rpx; background: transparent; color: var(--ink-secondary); font-size: 22rpx; text-decoration: underline; }
