.checklist-page { padding-bottom: calc(env(safe-area-inset-bottom) + 60rpx); }
.check-hero { display: grid; grid-template-columns: 176rpx 1fr; gap: 24rpx; align-items: center; }.check-hero image { width: 176rpx; height: 220rpx; border-radius: 26rpx; }.check-hero > view { display: flex; flex-direction: column; gap: 10rpx; }.check-title { font-size: 42rpx; font-weight: 700; }
.progress-card { margin: 28rpx 0 14rpx; padding: 24rpx; }.progress-card > view:first-child { display: flex; justify-content: space-between; font-size: 24rpx; }.progress-count { color: #587344; font-weight: 600; }.progress { height: 8rpx; margin-top: 17rpx; overflow: hidden; border-radius: 999rpx; background: #dedfd9; }.progress view { height: 100%; border-radius: inherit; background: #587344; transition: width .32s ease; }
.task-list { border-top: 1rpx solid #dfddd7; }.task { width: 100%; min-height: 164rpx; margin: 0; padding: 24rpx 2rpx; display: flex; align-items: center; gap: 20rpx; border-bottom: 1rpx solid #dfddd7; background: transparent; color: #292d29; text-align: left; line-height: 1.2; }.task.done { opacity: .64; }.check { width: 48rpx; height: 48rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; border: 2rpx solid #b9beb6; border-radius: 50%; }.done .check { border-color: #587344; background: #587344; animation: check-pop .25s ease; }@keyframes check-pop { 50% { transform: scale(1.18); } }
.task-copy { display: flex; flex: 1; flex-direction: column; gap: 7rpx; }.task-category { color: #587344; font-size: 21rpx; font-weight: 600; }.task-title { font-size: 28rpx; font-weight: 600; }.task-description, .task-meta { color: #757974; font-size: 22rpx; }.task-meta { color: #979a96; }
.finish-note { margin: 26rpx 0; padding: 24rpx; display: flex; flex-direction: column; gap: 10rpx; color: #727671; font-size: 23rpx; line-height: 1.6; }.finish-note .serif { color: #303430; font-size: 29rpx; font-weight: 700; }.checklist-loading { height: 900rpx; border-radius: 30rpx; }
