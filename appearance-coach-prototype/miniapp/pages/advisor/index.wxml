<app-header title="私人顾问" back="{{true}}" />
<view class="advisor-page">
  <scroll-view class="chat-scroll" scroll-y scroll-into-view="chat-end" enhanced show-scrollbar="{{false}}">
    <view class="advisor-context fade-up">
      <view class="advisor-avatar"><image src="/assets/icons/sparkles.svg" /></view>
      <view><text class="context-kicker">顾问已经了解</text><text class="context-title serif">你的档案、方案与今日安排</text></view>
      <view class="context-tags"><text>形象档案</text><text>今日天气</text><text>现有方案</text><text>我的衣橱</text></view>
    </view>

    <view wx:if="{{!messages.length}}" class="starter-card surface"><text>你可以直接这样问</text><view><button wx:for="{{suggestions}}" wx:key="*this" data-value="{{item}}" bindtap="chooseSuggestion">{{item}} <text>›</text></button></view></view>

    <view class="message-list">
      <view wx:for="{{messages}}" wx:key="id" class="message {{item.role}}"><text>{{item.content}}</text><view wx:if="{{item.actions.length}}" class="message-actions"><button wx:for="{{item.actions}}" wx:for-item="action" wx:key="id" data-id="{{action.id}}" disabled="{{action.applied}}" bindtap="applyAction">{{action.applied ? '已应用' : action.label}}</button></view></view>
      <view wx:if="{{sending}}" class="message assistant typing"><text>正在结合你的档案与今日安排…</text></view>
    </view>
    <view id="chat-end" class="chat-end" />
  </scroll-view>

  <view class="composer"><input value="{{input}}" placeholder="问这件怎么穿、明天怎么搭…" maxlength="500" confirm-type="send" bindinput="inputChange" bindconfirm="send" /><button class="{{input ? 'active' : ''}}" bindtap="send" loading="{{sending}}">发送</button></view>
</view>
