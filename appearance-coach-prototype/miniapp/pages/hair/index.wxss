.hair-page { padding-left: 28rpx; padding-right: 28rpx; padding-bottom: calc(env(safe-area-inset-bottom) + 56rpx); }
.page-intro { padding: 12rpx 6rpx 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }.page-intro > view { display: flex; flex-direction: column; gap: 8rpx; }.intro-title { font-size: 31rpx; font-weight: 700; }.intro-note { color: var(--ink-tertiary); font-size: 21rpx; }.ai-chip { flex: 0 0 auto; padding: 8rpx 13rpx; border-radius: 999rpx; background: #efeee9; color: var(--ink-secondary); font-size: 18rpx; }
.upload-card { width: 100%; height: 500rpx; margin: 0; padding: 48rpx 24rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid var(--line); border-radius: var(--radius-lg); background: var(--surface); color: var(--ink); line-height: 1.3; }.upload-icon { margin-bottom: 24rpx; }.upload-icon image { width: 72rpx; height: 72rpx; display: block; }.upload-title { font-size: 29rpx; font-weight: 700; }.upload-note { margin-top: 12rpx; color: var(--ink-secondary); font-size: 20rpx; }.upload-action { margin-top: 26rpx; padding: 13rpx 24rpx; border-radius: 999rpx; background: var(--moss); color: #fff; font-size: 21rpx; }
.preview-card { position: relative; height: 620rpx; overflow: hidden; border: 1rpx solid var(--line); border-radius: var(--radius-xl); background: #e9e8e4; }.preview-card > image { width: 100%; height: 100%; }.view-toggle { position: absolute; left: 18rpx; top: 18rpx; z-index: 3; padding: 5rpx; display: flex; border-radius: 999rpx; background: rgba(255,255,255,.9); }.view-toggle button { min-width: 78rpx; height: 54rpx; margin: 0; padding: 0 16rpx; border-radius: 999rpx; background: transparent; color: var(--ink-secondary); font-size: 20rpx; line-height: 54rpx; }.view-toggle button.active { background: var(--moss); color: #fff; }.preview-caption { position: absolute; left: 0; right: 0; bottom: 0; padding: 64rpx 24rpx 22rpx; display: flex; align-items: flex-end; justify-content: space-between; background: linear-gradient(transparent,rgba(27,31,26,.5)); color: #fff; }.preview-caption text:first-child { font-size: 28rpx; font-weight: 700; }.preview-caption text:last-child { font-size: 18rpx; opacity: .88; }
.generating-mask { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; background: rgba(36,43,34,.68); color: #fff; backdrop-filter: blur(8rpx); }.generation-value { font-family: Georgia,serif; font-size: 68rpx; }.generation-stage { margin-top: 12rpx; font-size: 25rpx; font-weight: 650; }.generation-note { margin-top: 14rpx; font-size: 18rpx; opacity: .74; }
.demo-row { padding: 15rpx 6rpx 0; display: flex; align-items: center; justify-content: center; gap: 4rpx; color: var(--ink-tertiary); font-size: 20rpx; }.demo-row button { margin: 0; padding: 0 8rpx; background: transparent; color: var(--ink); font-size: 20rpx; text-decoration: underline; }.inline-error { margin-top: 14rpx; padding: 18rpx 20rpx; display: flex; align-items: center; justify-content: space-between; border-radius: var(--radius-sm); background: #f8ece8; color: #985f50; font-size: 20rpx; }.inline-error button { margin: 0; padding: 4rpx 12rpx; background: transparent; color: var(--ink); font-size: 20rpx; }
.style-head { margin: 32rpx 6rpx 17rpx; display: flex; align-items: center; justify-content: space-between; }.style-head text:first-child { font-size: 27rpx; font-weight: 700; }.style-head text:last-child { color: var(--ink-tertiary); font-size: 20rpx; }.style-scroll { width: 100%; }.style-row { width: max-content; display: flex; gap: 12rpx; padding: 0 4rpx 3rpx; }.style-card { width: 210rpx; margin: 0; padding: 8rpx 8rpx 15rpx; overflow: hidden; display: flex; flex-direction: column; align-items: flex-start; border: 1rpx solid var(--line); border-radius: var(--radius-md); background: var(--surface); color: var(--ink); text-align: left; line-height: 1.2; }.style-card.active { border: 3rpx solid var(--moss); padding: 6rpx 6rpx 13rpx; }.style-card image { width: 100%; height: 190rpx; border-radius: var(--radius-sm); }.style-thumb { position: relative; width: 100%; }.style-card text:nth-child(2) { margin: 13rpx 8rpx 0; font-size: 23rpx; font-weight: 650; }.style-card text:nth-child(3) { margin: 7rpx 8rpx 0; color: var(--ink-tertiary); font-size: 18rpx; }
.reason-card { margin-top: 25rpx; padding: 24rpx; border: 1rpx solid var(--line); border-radius: var(--radius-lg); background: var(--surface); color: var(--ink-secondary); font-size: 22rpx; line-height: 1.7; }.reason-title { margin-bottom: 12rpx; color: var(--ink); font-size: 25rpx; font-weight: 700; }.reason-tags { margin-top: 16rpx; display: flex; flex-wrap: wrap; gap: 9rpx; }.reason-tags text { padding: 8rpx 12rpx; border-radius: 999rpx; background: #efeee9; color: var(--ink-secondary); font-size: 18rpx; }.privacy-note { margin-top: 22rpx; display: flex; flex-direction: column; align-items: center; gap: 5rpx; color: var(--ink-tertiary); font-size: 18rpx; }.hair-action { margin-top: 24rpx; }.secondary-action { width: 100%; min-height: 78rpx; margin-top: 10rpx; background: transparent; color: var(--ink); font-size: 23rpx; }
.tool-loading { padding-top: 24rpx; }.loading-image { height: 620rpx; border-radius: var(--radius-xl); }.loading-line { width: 76%; height: 32rpx; margin-top: 28rpx; border-radius: 10rpx; }.loading-line.short { width: 48%; margin-top: 14rpx; }.tool-error { min-height: calc(100vh - 200rpx - env(safe-area-inset-bottom) - 56rpx); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; text-align: center; }.tool-error image { width: 64rpx; height: 64rpx; opacity: .65; }.tool-error text:nth-child(2) { font-size: 28rpx; font-weight: 700; }.tool-error text:nth-child(3) { color: var(--ink-secondary); font-size: 21rpx; }.tool-error button { min-width: 190rpx; margin-top: 10rpx; padding: 16rpx 28rpx; border-radius: var(--radius-md); background: var(--moss); color: #fff; font-size: 22rpx; }
