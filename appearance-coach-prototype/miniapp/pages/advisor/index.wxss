.advisor-page { min-height: 100vh; background: var(--app-bg); }
.chat-scroll { height: 100vh; }
.chat-scroll > view { padding: 200rpx 32rpx calc(env(safe-area-inset-bottom) + 170rpx); }

/* Context card */
.advisor-context { padding: 26rpx; display: grid; grid-template-columns: 72rpx 1fr; gap: 18rpx; border-radius: 28rpx; background: #eef2e9; border: 1rpx solid rgba(86,114,67,.14); }
.advisor-avatar { width: 72rpx; height: 72rpx; padding: 18rpx; box-sizing: border-box; border-radius: 22rpx; background: #fff; }
.advisor-avatar image { width: 100%; height: 100%; }
.advisor-context > view:nth-child(2) { display: flex; flex-direction: column; justify-content: center; gap: 6rpx; }
.context-kicker { color: #587344; font-size: 20rpx; }
.context-title { font-size: 28rpx; font-weight: 700; }
.context-tags { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 10rpx; }
.context-tags text { padding: 8rpx 14rpx; border-radius: 999rpx; background: rgba(255,255,255,.75); color: #657060; font-size: 19rpx; }

/* Starter suggestions */
.starter-card { margin-top: 26rpx; padding: 26rpx; }
.starter-card > text { font-size: 24rpx; font-weight: 650; }
.starter-card > view { margin-top: 14rpx; display: grid; }
.starter-card button { width: 100%; margin: 0; padding: 22rpx 0; display: flex; justify-content: space-between; border-bottom: 1rpx solid #e4e2dc; background: transparent; color: #535a52; text-align: left; font-size: 23rpx; }
.starter-card button::after { border: none; }
.starter-card button:last-child { border: 0; }
.starter-card button text { color: #587344; }

/* Messages: user = sage bubble, assistant = flat editorial text */
.message-list { margin-top: 36rpx; display: flex; flex-direction: column; gap: 36rpx; }
.msg { display: flex; flex-direction: column; }
.msg.user { align-items: flex-end; }
.msg.user .msg-bubble { max-width: 78%; padding: 20rpx 26rpx; border-radius: 28rpx 28rpx 8rpx 28rpx; background: #587344; color: #fff; font-size: 26rpx; line-height: 1.65; box-shadow: 0 10rpx 26rpx rgba(88,115,68,.2); }
.msg.assistant .msg-bubble { width: 100%; padding: 0 4rpx; color: #343934; font-size: 26rpx; line-height: 1.78; }

/* Action chips under assistant replies */
.msg-actions { margin-top: 18rpx; display: flex; flex-wrap: wrap; gap: 14rpx; }
.action-chip { margin: 0; padding: 14rpx 24rpx; border-radius: 999rpx; background: #eef2e9; color: #587344; font-size: 22rpx; font-weight: 600; line-height: 1.3; }
.action-chip::after { border: none; }
.action-chip.applied { background: #587344; color: #fff; }

/* Typing indicator */
.typing { display: flex; align-items: center; gap: 10rpx; padding: 4rpx; }
.typing .dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #a9b59e; animation: advisor-blink 1.2s ease-in-out infinite; }
.typing .dot:nth-child(2) { animation-delay: .2s; }
.typing .dot:nth-child(3) { animation-delay: .4s; }
.typing-copy { margin-left: 8rpx; color: #8a9089; font-size: 23rpx; }
@keyframes advisor-blink { 50% { opacity: .3; transform: translateY(-4rpx); } }
.chat-end { height: 2rpx; }

/* Composer */
.composer { position: fixed; z-index: 30; left: 0; right: 0; bottom: 0; padding: 14rpx 24rpx calc(env(safe-area-inset-bottom) + 14rpx); display: grid; grid-template-columns: 1fr 78rpx; gap: 16rpx; align-items: center; border-top: 1rpx solid rgba(69,78,64,.08); background: rgba(248,247,243,.94); }
.composer input { height: 78rpx; padding: 0 28rpx; border-radius: 999rpx; background: #fff; border: 1rpx solid rgba(69,78,64,.12); font-size: 25rpx; }
.composer-ph { color: #a6aaa4; }
.composer button { width: 78rpx; height: 78rpx; margin: 0; padding: 0; border-radius: 50%; background: #e2e3de; color: #9aa098; font-size: 24rpx; line-height: 78rpx; text-align: center; }
.composer button::after { border: none; }
.composer button.active { background: #587344; color: #fff; box-shadow: 0 8rpx 20rpx rgba(88,115,68,.28); }
