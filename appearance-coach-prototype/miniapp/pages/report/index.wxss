.report-page { padding-bottom: calc(env(safe-area-inset-bottom) + 56rpx); }
.loading-view { padding-top: 30rpx; }.skeleton-title { width: 76%; height: 92rpx; border-radius: 18rpx; }.skeleton-photo { height: 700rpx; margin-top: 34rpx; border-radius: 32rpx; }
.status { display: flex; align-items: center; gap: 12rpx; color: #587344; font-size: 24rpx; }
.report-title { display: block; margin: 34rpx 0 26rpx; font-size: 40rpx; line-height: 1.26; font-weight: 700; word-break: keep-all; }
.current-card { position: relative; height: 672rpx; overflow: hidden; border-radius: 27rpx; background: #e8e7e3; box-shadow: 0 20rpx 58rpx rgba(48,51,47,.08); }
.current-card > image, .current-card > smart-image { width: 100%; height: 100%; }
.current-photo { width: 100%; height: 100%; }
.image-unavailable { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; color: #7d837a; font-size: 22rpx; }
.image-unavailable image { width: 112rpx; height: 112rpx; opacity: .58; }
.current-label { position: absolute; top: 18rpx; left: 18rpx; padding: 9rpx 15rpx; border-radius: 10rpx; background: rgba(255,255,255,.9); font-size: 22rpx; }
.finding { position: absolute; z-index: 2; max-width: 280rpx; min-height: 60rpx; padding: 10rpx 15rpx; display: flex; align-items: center; gap: 9rpx; border: 1rpx solid #8ea27f; border-radius: 13rpx; background: rgba(251,250,247,.94); color: #474b46; font-size: 22rpx; box-shadow: 0 8rpx 18rpx rgba(45,52,42,.08); transform: translateY(-50%); }
.connector { position: absolute; z-index: -1; width: 72rpx; height: 1rpx; background: #819472; transform-origin: 0 50%; }
.number { width: 34rpx; height: 34rpx; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; border: 1rpx solid #6f8b5d; border-radius: 50%; color: #587344; font-size: 19rpx; }
.finding-right { transform: translate(0, -50%); }
.finding-right .connector { right: 100%; top: 62%; transform: rotate(12deg); transform-origin: 100% 50%; }
.finding-left { transform: translate(-100%, -50%); }
.finding-left .connector { left: 100%; top: 62%; transform: rotate(-12deg); transform-origin: 0 50%; }
.impression { margin: 28rpx 4rpx; display: flex; align-items: flex-start; gap: 18rpx; flex-wrap: wrap; }
.impression-title { flex: none; font-size: 31rpx; font-weight: 700; white-space: nowrap; }
.impression .pill-row { flex: 1; min-width: 0; justify-content: flex-start; flex-wrap: wrap; gap: 12rpx; }.impression .pill { padding: 12rpx 18rpx; white-space: nowrap; }
.priority { padding: 28rpx; display: grid; grid-template-columns: 72rpx 1fr; gap: 18rpx; align-items: center; }
.priority-star { width: 64rpx; height: 64rpx; padding: 12rpx; border: 1rpx solid #cbd5c1; border-radius: 50%; }.priority-star image { width: 100%; height: 100%; }
.priority-content { display: flex; flex-direction: column; gap: 10rpx; }
.priority-label { color: #587344; font-size: 22rpx; }.priority-title { font-size: 36rpx; font-weight: 700; }.priority-copy { color: #737772; font-size: 24rpx; line-height: 1.65; }
.suggestions .section-title { display: block; }
.suggestions { overflow: hidden; border: 1rpx solid #e0ddd6; border-radius: 22rpx; }.suggestions .section-title { margin: 0; padding: 28rpx 24rpx 12rpx; }
.suggestion-row { min-height: 86rpx; padding: 0 20rpx; display: grid; grid-template-columns: 50rpx 90rpx 1fr 34rpx; align-items: center; border-bottom: 1rpx solid #dfddd7; color: #686c67; font-size: 23rpx; }
.suggestion-row:last-child { border-bottom: 0; }.suggestion-row image { width: 38rpx; height: 38rpx; }.chevron { color: #587344; font-size: 30rpx; text-align: right; }
.suggestion-type { color: #292d29; font-weight: 600; }
.suggestion-copy { line-height: 1.5; }

/* Detailed findings */
.details { margin-top: 28rpx; overflow: hidden; border: 1rpx solid #e0ddd6; border-radius: 22rpx; }
.details .section-title { display: block; margin: 0; padding: 28rpx 24rpx 6rpx; }
.detail-row { padding: 18rpx 24rpx 24rpx; border-bottom: 1rpx solid #eceae4; }
.detail-row:last-child { border-bottom: 0; }
.detail-head { display: flex; align-items: center; gap: 12rpx; }
.detail-number { flex: none; width: 32rpx; height: 32rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #6f8b5d; border-radius: 50%; color: #587344; font-size: 18rpx; }
.detail-label { flex: 1; color: #292d29; font-size: 25rpx; font-weight: 600; }
.detail-chip { flex: none; padding: 5rpx 14rpx; border-radius: 999rpx; background: rgba(88,115,68,.1); color: #587344; font-size: 19rpx; }
.detail-severity { flex: none; font-size: 19rpx; color: #8a9089; }
.detail-severity.severity-medium { color: #587344; }
.detail-severity.severity-high { color: #a9683c; }
.detail-copy { display: block; margin-top: 12rpx; color: #737772; font-size: 23rpx; line-height: 1.65; }

.report-action { margin-top: 34rpx; }.reanalyze-action { width: 100%; margin: 12rpx 0 0; padding: 18rpx; background: transparent; color: #587344; font-size: 22rpx; text-decoration: underline; }
