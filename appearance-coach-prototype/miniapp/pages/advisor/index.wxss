.advisor-page { min-height: 100vh; background: var(--app-bg); }.chat-scroll { height: 100vh; }.chat-scroll > view { padding: 200rpx 30rpx calc(env(safe-area-inset-bottom) + 160rpx); }.advisor-context { padding: 25rpx; display: grid; grid-template-columns: 68rpx 1fr; gap: 15rpx; border-radius: 25rpx; background: #eef2e9; border: 1rpx solid rgba(86,114,67,.14); }.advisor-avatar { width: 68rpx; height: 68rpx; padding: 17rpx; border-radius: 20rpx; background: #fff; }.advisor-avatar image { width: 100%; height: 100%; }.advisor-context > view:nth-child(2) { display: flex; flex-direction: column; gap: 5rpx; }.context-kicker { color: #587344; font-size: 19rpx; }.context-title { font-size: 27rpx; font-weight: 700; }.context-tags { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8rpx; }.context-tags text { padding: 8rpx 12rpx; border-radius: 999rpx; background: rgba(255,255,255,.75); color: #657060; font-size: 18rpx; }
.starter-card { margin-top: 24rpx; padding: 24rpx; }.starter-card > text { font-size: 23rpx; font-weight: 650; }.starter-card > view { margin-top: 12rpx; display: grid; }.starter-card button { width: 100%; margin: 0; padding: 19rpx 0; display: flex; justify-content: space-between; border-bottom: 1rpx solid #e4e2dc; background: transparent; color: #535a52; text-align: left; font-size: 21rpx; }.starter-card button:last-child { border: 0; }.starter-card button text { color: #587344; }
.message-list { margin-top: 25rpx; display: flex; flex-direction: column; gap: 16rpx; }.message { max-width: 84%; padding: 20rpx 22rpx; border-radius: 22rpx; font-size: 23rpx; line-height: 1.62; }.message.user { align-self: flex-end; border-bottom-right-radius: 7rpx; background: #587344; color: #fff; }.message.assistant { align-self: flex-start; border-bottom-left-radius: 7rpx; background: #fff; color: #343934; box-shadow: 0 10rpx 28rpx rgba(44,50,41,.06); }.message.typing { color: #7d837c; }.message-actions { margin-top: 15rpx; }.message-actions button { margin: 0; padding: 12rpx 18rpx; border-radius: 999rpx; background: #eef2e9; color: #587344; font-size: 19rpx; line-height: 1.2; }.chat-end { height: 2rpx; }
.composer { position: fixed; z-index: 30; left: 0; right: 0; bottom: 0; padding: 16rpx 24rpx calc(env(safe-area-inset-bottom) + 16rpx); display: grid; grid-template-columns: 1fr 92rpx; gap: 10rpx; border-top: 1rpx solid rgba(69,78,64,.1); background: rgba(248,247,243,.95); }.composer input { height: 76rpx; padding: 0 20rpx; border-radius: 19rpx; background: #fff; font-size: 22rpx; }.composer button { width: 92rpx; height: 76rpx; margin: 0; padding: 0; border-radius: 19rpx; background: #dddeda; color: #888e87; font-size: 21rpx; line-height: 76rpx; }.composer button.active { background: #587344; color: #fff; }
