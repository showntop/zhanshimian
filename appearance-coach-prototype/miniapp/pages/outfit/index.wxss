.outfit-page { padding-left: 28rpx; padding-right: 28rpx; }
.tool-intro { padding: 12rpx 6rpx 26rpx; display: flex; flex-direction: column; gap: 9rpx; }
.intro-title { font-size: 33rpx; font-weight: 700; }
.intro-note { color: var(--ink-secondary); font-size: 22rpx; line-height: 1.55; }
.upload-card { position: relative; width: 100%; height: 650rpx; margin: 0; padding: 0; overflow: hidden; border: 1rpx solid var(--line); border-radius: var(--radius-xl); background: var(--surface); color: var(--ink-secondary); }
.upload-card > image { width: 100%; height: 100%; }
.upload-empty { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; }
.upload-icon { width: 72rpx; height: 72rpx; }
.upload-icon image { width: 100%; height: 100%; display: block; }
.upload-empty > text:nth-child(2) { color: var(--ink); font-size: 27rpx; font-weight: 650; }
.upload-empty > text:last-child { color: var(--ink-tertiary); font-size: 20rpx; }
.replace-chip { position: absolute; right: 18rpx; top: 18rpx; padding: 9rpx 13rpx; border-radius: 999rpx; background: rgba(255,255,255,.9); color: var(--ink); font-size: 19rpx; }
.context-row { margin-top: 24rpx; display: flex; align-items: center; justify-content: space-between; }
.context-row > text { font-size: 24rpx; font-weight: 650; }
.context-row > view { display: flex; gap: 8rpx; }
.context-row button { min-width: 84rpx; min-height: 56rpx; margin: 0; padding: 0 14rpx; border-radius: 999rpx; background: #f1f0eb; color: var(--ink-secondary); font-size: 20rpx; line-height: 56rpx; }
.context-row button.active { background: var(--moss); color: #fff; }
.demo-action, .secondary-action { width: 100%; min-height: 72rpx; margin-top: 10rpx; background: transparent; color: var(--ink); font-size: 22rpx; }
.outfit-action { margin-top: 16rpx; }
.diagnosis-progress { position: relative; margin-top: 16rpx; padding: 22rpx; overflow: hidden; display: flex; align-items: center; gap: 16rpx; border: 1rpx solid var(--line); border-radius: var(--radius-md); background: var(--surface); }.progress-scan { width: 44rpx; height: 44rpx; border: 4rpx solid var(--line); border-top-color: var(--moss); border-radius: 50%; animation: spin 1s linear infinite; }.diagnosis-progress > view:last-child { display: flex; flex-direction: column; gap: 6rpx; }.diagnosis-progress text:first-child { color: var(--ink); font-size: 22rpx; font-weight: 650; }.diagnosis-progress text:last-child { color: var(--ink-tertiary); font-size: 18rpx; }@keyframes spin { to { transform: rotate(360deg); } }
.tool-error-copy { display: block; margin: 12rpx 4rpx 0; color: #9a5d50; font-size: 20rpx; text-align: center; }
.privacy-note { margin-top: 18rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; color: var(--ink-tertiary); font-size: 20rpx; }
.privacy-note image { width: 30rpx; height: 30rpx; }
.result-head { padding: 12rpx 5rpx 24rpx; display: flex; align-items: flex-end; justify-content: space-between; gap: 16rpx; }
.result-head > view { display: flex; flex-direction: column; gap: 8rpx; }
.result-kicker { color: var(--moss); font-size: 20rpx; }
.result-title { font-size: 31rpx; font-weight: 700; }
.saved-chip { flex: 0 0 auto; padding: 8rpx 12rpx; border-radius: 999rpx; background: #efeee9; color: var(--ink-secondary); font-size: 18rpx; }
.annotated-look { position: relative; height: 650rpx; overflow: hidden; border-radius: var(--radius-xl); background: #e9e8e4; }
.annotated-look image { width: 100%; height: 100%; }
.issue-marker { position: absolute; display: flex; align-items: center; pointer-events: none; }.issue-dot { width: 16rpx; height: 16rpx; flex: 0 0 auto; border: 3rpx solid rgba(255,255,255,.95); border-radius: 50%; background: var(--moss); box-shadow: 0 0 0 1rpx var(--moss); }.issue-line { width: 46rpx; height: 1rpx; background: var(--moss); }.issue-tag { padding: 10rpx 15rpx; border: 1rpx solid var(--line); border-radius: 999rpx; background: rgba(255,255,255,.94); color: var(--ink); font-size: 20rpx; box-shadow: 0 6rpx 18rpx rgba(38,43,35,.09); }.issue-right { flex-direction: row-reverse; }.issue-right .issue-line { transform: rotate(180deg); }
.priority-card { margin-top: 22rpx; padding: 26rpx; border-radius: var(--radius-lg); background: var(--moss-soft); }
.priority-kicker { display: block; color: var(--moss); font-size: 20rpx; }
.priority-title { display: block; margin-top: 10rpx; font-size: 29rpx; font-weight: 700; }
.priority-copy { display: block; margin-top: 11rpx; color: var(--ink-secondary); font-size: 22rpx; line-height: 1.65; }
.effect-row { margin-top: 18rpx; display: flex; gap: 8rpx; flex-wrap: wrap; }
.effect-row text { padding: 8rpx 11rpx; border-radius: 999rpx; background: rgba(255,255,255,.72); color: var(--ink-secondary); font-size: 18rpx; }
.result-actions { margin-top: 24rpx; }
.ai-disclaimer { display: block; margin: 8rpx 12rpx 0; color: var(--ink-tertiary); font-size: 18rpx; line-height: 1.5; text-align: center; }
