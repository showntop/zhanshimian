<app-header title="方案执行清单" back="{{true}}" />
<view class="page checklist-page">
  <block wx:if="{{plan}}">
    <view class="check-hero fade-up"><image src="{{plan.image_url}}" mode="aspectFill" /><view><text class="eyebrow">你选择了</text><text class="check-title serif">{{plan.name}}</text><text class="muted">{{plan.descriptor}}</text></view></view>
    <view class="progress-card surface fade-up delay-1"><view><text>完成进度</text><text class="progress-count">{{completed}} / {{items.length}}</text></view><view class="progress"><view style="width: {{items.length ? completed / items.length * 100 : 0}}%" /></view></view>
    <view class="task-list fade-up delay-2">
      <button wx:for="{{items}}" wx:key="id" class="task {{item.completed ? 'done' : ''}}" data-index="{{index}}" bindtap="toggle">
        <view class="check"><icon wx:if="{{item.completed}}" type="success_no_circle" size="22" color="#ffffff" /></view>
        <view class="task-copy"><text class="task-category">{{item.category === 'hair' ? '发型' : item.category === 'makeup' ? '妆容' : '穿搭'}}</text><text class="task-title">{{item.title}}</text><text class="task-description">{{item.description}}</text><text class="task-meta">{{item.meta}}</text></view>
      </button>
    </view>
    <view class="finish-note surface"><text class="serif">照着步骤完成，不需要一次买齐</text><text>勾选已经做过的调整；实际尝试后可以反馈，下一次推荐会更贴合你。</text></view>
    <primary-button text="提交实际体验反馈" bind:tap="feedback" />
  </block>
  <view wx:elif="{{loading}}" class="skeleton checklist-loading" />
  <view wx:else class="load-error"><text>加载失败，请稍后重试</text><button bindtap="load">重新加载</button></view>
</view>
