.today-page { padding-left: 32rpx; padding-right: 32rpx; }
.context-line { display: flex; align-items: center; gap: 8rpx; color: #5c7350; font-size: 20rpx; }
.context-line image { width: 30rpx; height: 30rpx; }.context-line text:last-child { margin-left: auto; color: #7b817a; }
.context-city { margin: 0; padding: 0; background: transparent; color: #5c7350; font-size: 20rpx; line-height: 1.4; text-align: left; }
.context-city::after { border: none; }
.today-kicker { display: block; margin-top: 34rpx; color: #587344; font-size: 22rpx; letter-spacing: 3rpx; }
.today-heading { display: block; margin-top: 13rpx; font-size: 48rpx; line-height: 1.25; font-weight: 700; }
.today-summary { display: block; margin-top: 13rpx; color: #727871; font-size: 24rpx; line-height: 1.65; }
.today-hero { position: relative; width: 100%; height: 590rpx; margin: 30rpx 0 0; padding: 0; overflow: hidden; border-radius: 28rpx; background: #e4e4df; }
.today-hero image { width: 100%; height: 100%; }.image-chip,.zoom-copy { position: absolute; padding: 8rpx 13rpx; border-radius: 9rpx; background: rgba(255,255,255,.9); color: #587344; font-size: 19rpx; }.image-chip { left: 18rpx; top: 18rpx; }.zoom-copy { right: 18rpx; bottom: 18rpx; }
.step-list { margin-top: 22rpx; overflow: hidden; border: 1rpx solid var(--line); border-radius: 24rpx; background: rgba(255,255,255,.72); }
.step-row { min-height: 116rpx; padding: 22rpx; display: grid; grid-template-columns: 76rpx 1fr; gap: 14rpx; border-bottom: 1rpx solid #e4e2dc; }.step-row:last-child { border: 0; }
.step-label { color: #587344; font-weight: 700; }.step-title { display: block; font-size: 24rpx; font-weight: 650; }.step-copy { display: block; margin-top: 7rpx; color: #7b817a; font-size: 20rpx; line-height: 1.45; }
.time-line { margin: 24rpx 0 18rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; color: #667960; font-size: 20rpx; }.time-line image { width: 28rpx; height: 28rpx; }
.secondary-actions { display: grid; grid-template-columns: repeat(3,1fr); gap: 9rpx; margin-top: 12rpx; }.secondary-actions button { min-width: 0; margin: 0; padding: 16rpx 4rpx; background: transparent; color: #587344; font-size: 20rpx; }
.feedback-card { margin-top: 26rpx; padding: 24rpx; }.feedback-card > text { font-weight: 650; }.feedback-row { margin-top: 16rpx; display: flex; flex-wrap: wrap; gap: 9rpx; }.feedback-row button { margin: 0; padding: 12rpx 17rpx; border-radius: 999rpx; background: #f0efe9; color: #666d65; font-size: 20rpx; line-height: 1.2; }.feedback-row button.active { background: #587344; color: #fff; }
.today-generating,.today-error { min-height: 760rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; color: #7a8178; text-align: center; font-size: 22rpx; line-height: 1.6; }.today-generating .serif,.today-error .serif { color: #303630; font-size: 34rpx; font-weight: 700; }.today-generating > text:last-child,.today-error > text:nth-child(3) { max-width: 540rpx; }.today-spinner { width: 52rpx; height: 52rpx; margin-bottom: 8rpx; border: 4rpx solid rgba(88,115,68,.2); border-top-color: #587344; border-radius: 50%; animation: today-spin .9s linear infinite; }@keyframes today-spin { to { transform: rotate(360deg); } }.today-error image { width: 62rpx; height: 62rpx; opacity: .62; }.today-error button { min-width: 260rpx; margin-top: 12rpx; border-radius: 18rpx; background: #587344; color: #fff; }.preview-overlay { position: fixed; z-index: 99; inset: 0; padding: 50rpx; display: flex; align-items: center; background: rgba(25,30,24,.88); }.preview-overlay view { width: 100%; height: 80vh; display: flex; flex-direction: column; gap: 15rpx; align-items: center; }.preview-overlay image { width: 100%; height: 100%; }.preview-overlay text { color: #fff; font-size: 20rpx; }
