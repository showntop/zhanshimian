<app-header title="穿搭诊断" back="{{true}}" />
<view class="page outfit-page">
  <view wx:if="{{!analyzed}}">
    <view class="tool-intro fade-up"><text class="intro-title">上传今天的穿搭</text><text class="intro-note">只指出最值得调整的一处，并告诉你怎么改</text></view>
    <button class="upload-card fade-up delay-1" bindtap="choosePhoto">
      <image wx:if="{{photo}}" src="{{photo}}" mode="aspectFill" />
      <view wx:else class="upload-empty"><view class="upload-icon"><image src="/assets/icons/document.png" /></view><text>拍照或从相册选择</text><text>建议站在自然光下拍摄正面全身</text></view>
      <text wx:if="{{photo}}" class="replace-chip">重新选择</text>
    </button>
    <view class="context-row fade-up delay-1"><text>使用场景</text><view><button wx:for="{{contexts}}" wx:key="*this" class="{{context === item ? 'active' : ''}}" data-value="{{item}}" bindtap="selectContext">{{item}}</button></view></view>
    <button wx:if="{{!photo}}" class="demo-action" bindtap="useDemo">使用示例穿搭体验</button>
    <text wx:if="{{error}}" class="tool-error-copy">{{error}}</text>
    <view class="outfit-action"><primary-button text="{{loading ? '正在诊断…' : '开始诊断'}}" loading="{{loading}}" disabled="{{!photo || loading}}" bind:tap="analyze" /></view>
	<view wx:if="{{loading}}" class="diagnosis-progress"><view class="progress-scan" /><view><text>正在看配色、肩线与比例</text><text>只会给你一处最值得先改的建议</text></view></view>
    <view class="privacy-note"><image src="/assets/icons/shield-check.png" /><text>穿搭照片默认不公开，可随时删除</text></view>
  </view>

  <view wx:else class="diagnosis-result fade-up">
	<view class="result-head"><view><text class="result-kicker">{{context}} · 穿搭诊断</text><text class="result-title">{{result.conclusion}}</text></view><text class="saved-chip">{{result.saved ? '已加入方案' : diagnosisLabel}}</text></view>
    <view class="annotated-look">
      <image src="{{photo}}" mode="aspectFit" />
	  <view wx:for="{{result.findings}}" wx:key="label" class="issue-marker issue-{{item.side}}" style="{{item.position}}"><view class="issue-dot" /><view class="issue-line" /><text class="issue-tag">{{item.label}}</text></view>
    </view>
    <view class="priority-card">
      <text class="priority-kicker">最值得先改</text>
      <text class="priority-title">{{result.priority_title}}</text>
      <text class="priority-copy">{{result.priority_copy}}</text>
      <view class="effect-row"><text wx:for="{{result.tags}}" wx:key="*this">{{item}}</text></view>
    </view>
    <text wx:if="{{error}}" class="tool-error-copy">{{error}}</text>
    <view class="result-actions"><primary-button text="{{loading ? '正在保存…' : '按建议生成替换方案'}}" loading="{{loading}}" disabled="{{loading}}" bind:tap="generateAlternative" /><button class="secondary-action" bindtap="reset">诊断另一套</button></view>
	<text class="ai-disclaimer">AI 建议基于照片中可见穿搭，仅供搭配决策参考</text>
  </view>
</view>
