<app-header title="{{replace ? '更新形象档案' : '建立形象档案'}}" back="{{true}}" help="{{true}}" bind:help="showHelp" />
<scroll-view class="capture-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="page capture-page">
    <view class="capture-intro fade-up">
      <text class="photo-count">{{completed ? ('已完成 ' + completed + ' / 3 张') : '需要 3 张照片'}}</text>
      <text class="capture-title serif">{{replace ? '重新拍 3 张照片，\n更新你的形象分析' : '拍 3 张照片，\n先看见更适合你的自己'}}</text>
      <text class="capture-lede">不用专业拍摄，按引导一次完成</text>
    </view>
    <view class="shots-panel fade-up delay-1">
      <button wx:for="{{shots}}" wx:key="kind" class="shot-column pressable {{index === completed ? 'active' : ''}}" data-index="{{index}}" bindtap="chooseOne">
        <text class="shot-title">{{item.title}}</text><text class="shot-tip">{{item.tip}}</text>
        <view class="shot-preview {{item.asset ? 'done' : ''}}">
          <image src="{{item.path || item.placeholder}}" mode="aspectFill" />
          <block wx:if="{{item.path}}"><view class="crop c1" /><view class="crop c2" /><view class="crop c3" /><view class="crop c4" /></block>
        </view>
        <view class="shot-state {{item.asset ? 'complete' : ''}}"><icon wx:if="{{item.asset}}" type="success_no_circle" size="19" color="#ffffff" /></view>
      </button>
    </view>
    <view class="light-tip fade-up delay-2">
      <image src="/assets/icons/sun.png" /><view><text>站在自然光下，关闭滤镜</text><text>穿合身衣服，露出肩颈与身体轮廓</text></view>
    </view>
    <view class="capture-actions fade-up delay-3">
      <primary-button text="{{completed === 3 ? '开始形象分析' : '开始连续拍摄'}}" loading="{{loading}}" bind:tap="primaryAction" />
      <button class="album-button" disabled="{{loading}}" bindtap="chooseFromAlbum">从相册选择</button>
      <button wx:if="{{demo}}" class="demo-link" disabled="{{loading}}" bindtap="useDemo">使用示例照片快速体验</button>
      <view class="privacy-bottom"><image src="/assets/icons/shield-check.png" /><text>照片仅用于生成分析，可随时删除</text></view>
    </view>
  </view>
</scroll-view>
