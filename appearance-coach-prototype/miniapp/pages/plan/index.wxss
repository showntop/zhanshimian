.plan-page { padding-bottom: calc(env(safe-area-inset-bottom) + 60rpx); }
.plan-meta { display: block; color: #587344; text-align: center; font-size: 24rpx; }
.plan-title { display: block; margin: 22rpx 0 8rpx; text-align: center; font-size: 48rpx; line-height: 1.25; font-weight: 700; }
.plan-subtitle { display: block; margin: 0 28rpx 26rpx; color: #747a73; text-align: center; font-size: 23rpx; line-height: 1.55; }
.hero { position: relative; height: 560rpx; overflow: hidden; border-radius: 28rpx; background: #e6e5e1; box-shadow: 0 18rpx 48rpx rgba(43,48,41,.11); }
.hero-image { width: 100%; height: 100%; background: #eeede8; }.current-thumb { position: absolute; top: 22rpx; left: 22rpx; width: 142rpx; height: 196rpx; border: 4rpx solid rgba(255,255,255,.8); border-radius: 20rpx; background: #efeee9; }
.current-label { position: absolute; top: 178rpx; left: 34rpx; padding: 6rpx 10rpx; background: rgba(255,255,255,.86); border-radius: 8rpx; font-size: 20rpx; }.scheme-label { position: absolute; top: 22rpx; right: 22rpx; padding: 10rpx 20rpx; border-radius: 999rpx; background: #587344; color: #fff; font-size: 22rpx; }
.compare-button { position: absolute; right: 26rpx; bottom: 72rpx; width: 90rpx; height: 90rpx; margin: 0; padding: 0; border-radius: 50%; background: rgba(255,255,255,.92); color: #587344; font-size: 22rpx; line-height: 90rpx; box-shadow: 0 10rpx 25rpx rgba(36,43,32,.12); }
.compare-note { position: absolute; left: 24rpx; bottom: 22rpx; color: #5e645d; font-size: 21rpx; }
.outcomes { margin: 28rpx 0 10rpx; display: grid; grid-template-columns: repeat(3,1fr); }.outcomes view { display: flex; flex-direction: column; align-items: center; gap: 9rpx; color: #4c524b; font-size: 22rpx; }
.section-title { display: block; }
.tabs { height: 82rpx; padding: 5rpx; display: grid; grid-template-columns: repeat(3,1fr); border: 1rpx solid #d9d9d3; border-radius: 22rpx; background: rgba(255,255,255,.5); }
.tabs button { margin: 0; padding: 0; border-radius: 17rpx; background: transparent; color: #656965; font-size: 26rpx; line-height: 70rpx; }.tabs button.active { background: #eef2e9; color: #587344; font-weight: 600; box-shadow: inset 0 -4rpx 0 #587344; }
.step { margin-top: 20rpx; padding: 0; overflow: hidden; }.step-copy { padding: 28rpx 28rpx 22rpx; }.step-kicker { display: block; margin-bottom: 8rpx; color: #587344; font-size: 20rpx; font-weight: 650; }.step-title { display: block; font-size: 35rpx; font-weight: 700; }.step-summary { display: block; margin-top: 10rpx; color: #777b76; font-size: 23rpx; line-height: 1.55; }
.detail-list { padding: 0 28rpx 12rpx; }.detail-row { min-height: 84rpx; display: grid; grid-template-columns: 124rpx 1fr; gap: 16rpx; align-items: center; border-top: 1rpx solid #dfddd7; font-size: 23rpx; line-height: 1.5; }.detail-row text:first-child { color: #2f332f; font-weight: 600; }.detail-row text:last-child { color: #6d716c; }
.detail-visual { position: relative; height: 390rpx; overflow: hidden; background: #ecebe6; }.detail-visual image { width: 100%; min-height: 100%; }.face-visual image { position: absolute; left: 0; top: 0; height: auto; }.outfit-visual image { height: 100%; }.visual-label { position: absolute; left: 18rpx; bottom: 18rpx; padding: 8rpx 13rpx; border-radius: 999rpx; background: rgba(255,255,255,.9); color: #587344; font-size: 18rpx; }.mark { position: absolute; width: 18rpx; height: 18rpx; border: 2rpx solid #fff; border-radius: 50%; background: #587344; box-shadow: 0 0 0 1rpx #587344; }.m1 { top: 16%; left: 44%; }.m2 { top: 31%; right: 24%; }.m3 { top: 65%; left: 22%; }
.collapsed { margin-top: 18rpx; border-top: 1rpx solid #dfddd7; }.collapsed-row { min-height: 84rpx; display: grid; grid-template-columns: 92rpx 1fr 54rpx; align-items: center; border-bottom: 1rpx solid #dfddd7; color: #656965; font-size: 23rpx; }.collapsed-type { color: #292d29; font-weight: 600; }.more { color: #587344; }
.time-note { display: block; margin: 28rpx 0 18rpx; color: #587344; text-align: center; font-size: 22rpx; }.execute-card { padding: 24rpx; border: 1rpx solid rgba(88,115,68,.16); border-radius: 24rpx; background: var(--moss-soft); }.execute-card > view { margin-bottom: 18rpx; display: flex; flex-direction: column; gap: 7rpx; }.execute-card > view text:first-child { color: #303630; font-size: 27rpx; font-weight: 700; }.execute-card > view text:last-child { color: #75806f; font-size: 21rpx; line-height: 1.5; }.plan-utilities { margin-top: 14rpx; display: grid; grid-template-columns: repeat(3,1fr); gap: 8rpx; }.plan-utilities button { min-width: 0; margin: 0; padding: 17rpx 4rpx; border: 1rpx solid #dfe3da; border-radius: 16rpx; background: rgba(255,255,255,.6); color: #587344; font-size: 20rpx; line-height: 1.2; }.loading-card { height: 900rpx; border-radius: 32rpx; }
