APP_ENV=development
ADDR=:8080
# Docker Compose uses the postgres service name. For direct host execution,
# override this with postgres://jianwo:jianwo@localhost:55432/jianwo?sslmode=disable.
DATABASE_URL=postgres://jianwo:jianwo@postgres:5432/jianwo?sslmode=disable
PUBLIC_BASE_URL=http://localhost:58000
UPLOAD_DIR=data/uploads
ASSET_DIR=assets
DEV_LOGIN_ENABLED=true
RUN_WORKER=true

# Formal WeChat login. Keep the secret empty only while development login is enabled.
WECHAT_APP_ID=wx911e0fbcba0b24d0
WECHAT_APP_SECRET=
WECHAT_API_BASE_URL=https://api.weixin.qq.com/sns/jscode2session
WECHAT_REQUEST_TIMEOUT_SECONDS=5

# Private photo storage. Production requires COS and short-lived read URLs.
STORAGE_PROVIDER=local
ASSET_URL_TTL_SECONDS=900
COS_BUCKET_URL=
ASSET_BUCKET=
ASSET_S3_ENDPOINT=
ASSET_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_KEY_PREFIX=jianwo

# Real weather for the daily styling hook. Shanghai defaults are used by v1.
WEATHER_PROVIDER=demo
WEATHER_REQUEST_TIMEOUT_SECONDS=5
AMAP_WEB_SERVICE_KEY=
AMAP_API_BASE_URL=https://restapi.amap.com/v3/weather/weatherInfo
AMAP_DEFAULT_CITY=上海
AMAP_DEFAULT_ADCODE=310000

# Unified capability routing. Leave empty to keep the legacy demo/OpenAI switches below.
# With Docker Compose, set AI_ROUTING_FILE=/app/config/ai-routing.json and optionally
# point AI_ROUTING_HOST_FILE at a private deployment copy of the example catalog.
AI_ROUTING_FILE=
AI_ROUTING_JSON=
AI_ROUTING_HOST_FILE=./server/config/ai-routing.example.json
ALIYUN_API_KEY=
VOLCENGINE_API_KEY=
BAILIAN_WORKSPACE_ID=

# AI_PROVIDER=demo keeps the repository self-contained. Set openai for real photo analysis.
AI_PROVIDER=demo
AI_FALLBACK_TO_DEMO=true
AI_REQUEST_TIMEOUT_SECONDS=90
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-5-mini

# Hair preview runs as an independent async image-editing task.
HAIR_PREVIEW_PROVIDER=demo
HAIR_PREVIEW_FALLBACK_TO_DEMO=true
HAIR_PREVIEW_TIMEOUT_SECONDS=150
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

# Single-photo structured outfit diagnosis.
OUTFIT_DIAGNOSIS_PROVIDER=demo
OUTFIT_DIAGNOSIS_FALLBACK_TO_DEMO=true
OUTFIT_DIAGNOSIS_TIMEOUT_SECONDS=60
OPENAI_OUTFIT_MODEL=gpt-5-mini
