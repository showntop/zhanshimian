.plans-page { padding-left: 0; padding-right: 0; padding-bottom: calc(env(safe-area-inset-bottom) + 90rpx); }
.scene-switch { margin: 22rpx 0 2rpx; white-space: nowrap; }
.scene-switch-row { display: inline-flex; gap: 10rpx; padding: 0 32rpx; }
.scene-tab { flex: 0 0 auto; margin: 0; padding: 12rpx 24rpx; border-radius: 999rpx; background: #eeeee9; color: #6d736c; font-size: 21rpx; line-height: 1.2; }
.scene-tab.active { background: #587344; color: #fff; font-weight: 600; }
.intro { padding: 0 40rpx; text-align: center; }.scene-context { display: block; margin-bottom: 12rpx; color: var(--moss); font-size: 22rpx; letter-spacing: 2rpx; }.plans-title { display: block; font-size: 43rpx; line-height: 1.28; font-weight: 700; }.intro .lede { display: block; margin-top: 12rpx; }
.counter { display: block; margin: 24rpx 0 14rpx; color: var(--moss); text-align: center; font-size: 24rpx; }
.plan-swiper { height: 584rpx; }
.plan-card { position: relative; height: 552rpx; margin: 12rpx; overflow: hidden; border-radius: var(--radius-xl); background: #e8e7e3; transform: scale(.95); opacity: .7; transition: transform .34s ease, opacity .34s ease; box-shadow: 0 14rpx 38rpx rgba(40,45,38,.08); }
.plan-card.active { transform: scale(1); opacity: 1; box-shadow: 0 20rpx 52rpx rgba(40,45,38,.14); }
.plan-card > image { width: 100%; height: 100%; transition: opacity .25s ease; }
.plan-card > image.generated-look { background: #eeede8; }
.photo-shade { position: absolute; left: 0; right: 0; bottom: 0; height: 220rpx; background: rgba(27,31,26,.34); }
.recommend { position: absolute; top: 20rpx; left: 20rpx; padding: 9rpx 15rpx; border-radius: 10rpx; background: var(--moss); color: #fff; font-size: 20rpx; }
.compare { position: absolute; top: 18rpx; right: 18rpx; padding: 4rpx; display: flex; flex-direction: row; border-radius: 999rpx; background: rgba(255,255,255,.94); }
.compare button { min-width: 70rpx; height: 54rpx; margin: 0; padding: 0 12rpx; border-radius: 999rpx; background: transparent; color: #505650; font-size: 19rpx; line-height: 54rpx; }
.compare button.active { background: var(--moss); color: #fff; }
.card-copy { position: absolute; left: 24rpx; right: 24rpx; bottom: 24rpx; display: flex; flex-direction: column; gap: 8rpx; color: #fff; font-size: 23rpx; }.card-name { font-size: 39rpx; font-weight: 700; }
.look-badge { align-self: flex-start; padding: 5rpx 14rpx; border-radius: 999rpx; background: rgba(255,255,255,.22); color: #fff; font-size: 18rpx; letter-spacing: 1rpx; }
.gen-cta { margin: 4rpx 34rpx 0; }
.generation-summary { margin: 18rpx 34rpx 0; padding: 18rpx 22rpx; display: grid; grid-template-columns: 34rpx 1fr; gap: 3rpx 14rpx; align-items: center; border: 1rpx solid rgba(88,115,68,.16); border-radius: 18rpx; background: var(--moss-soft); color: #587344; font-size: 22rpx; font-weight: 600; text-align: left; }
.generation-summary .gen-spinner { grid-row: 1 / 3; width: 28rpx; height: 28rpx; border-width: 3rpx; }
.generation-summary text:last-child { color: #7e8878; font-size: 18rpx; font-weight: 400; }
.gen-overlay { position: absolute; inset: 0; z-index: 3; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; background: rgba(240,239,234,.9); color: #587344; font-size: 25rpx; font-weight: 600; }
.gen-note { color: #8a9089; font-size: 21rpx; font-weight: 400; }
.gen-spinner { width: 44rpx; height: 44rpx; border: 4rpx solid rgba(88,115,68,.25); border-top-color: #587344; border-radius: 50%; animation: gen-spin .9s linear infinite; }
@keyframes gen-spin { to { transform: rotate(360deg); } }
.gen-overlay.fail { color: #7a6a45; }
.gen-retry { margin: 6rpx 0 0; padding: 10rpx 34rpx; border: 1rpx solid #587344; border-radius: 999rpx; background: transparent; color: #587344; font-size: 23rpx; line-height: 1.6; }
.gen-retry::after { border: none; }
.generation-fail { min-height: 56vh; margin: 0 56rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.generation-fail-badge { width: 128rpx; height: 128rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(122,106,69,.1); }
.generation-fail-badge image { width: 66rpx; height: 66rpx; opacity: .72; }
.generation-fail-title { margin-top: 30rpx; color: #353a34; font-size: 38rpx; font-weight: 700; }
.generation-fail-copy { margin-top: 22rpx; color: #747873; font-size: 26rpx; line-height: 1.7; }
.generation-fail-action { width: 100%; margin-top: 46rpx; }
.thumbs { padding: 8rpx 128rpx 0; display: grid; grid-template-columns: repeat(3,1fr); gap: 12rpx; }
.thumb { margin: 0; padding: 0 0 10rpx; overflow: hidden; border: 2rpx solid transparent; border-radius: var(--radius-md); background: rgba(255,255,255,.5); color: #5f635f; font-size: 20rpx; line-height: 1.2; }.thumb.active { border-color: var(--moss); color: var(--moss); font-weight: 600; }.thumb image { width: 100%; height: 108rpx; margin-bottom: 8rpx; }.thumb image.generated-thumb { background: #efeee9; }
.why { margin: 24rpx 34rpx 0; padding: 26rpx; display: flex; flex-direction: column; gap: 12rpx; }.why-title { font-size: 30rpx; font-weight: 700; }.why-copy { color: var(--ink-secondary); font-size: 23rpx; line-height: 1.6; }
.change-tags { display: flex; gap: 8rpx; flex-wrap: wrap; }.change-tags text { padding: 9rpx 13rpx; border-radius: 999rpx; background: var(--moss-soft); color: var(--moss); font-size: 20rpx; }
.plans-action { margin: 24rpx 34rpx 0; }.plan-placeholder { height: 600rpx; margin: 40rpx 70rpx; border-radius: var(--radius-xl); }
.plans-empty { margin: 130rpx 64rpx 0; display: flex; flex-direction: column; align-items: center; gap: 18rpx; color: #7b7f79; text-align: center; }.plans-empty .serif { color: #2e332e; font-size: 38rpx; font-weight: 700; }.plans-empty primary-button { width: 100%; }.plans-empty .plans-empty-secondary { margin-top: 0; border: 1rpx solid #587344; border-radius: 20rpx; background: transparent; color: #587344; }
.saved-section { margin: 34rpx 34rpx 0; padding: 28rpx 0 24rpx; border-top: 1rpx solid rgba(63,70,60,.12); }.saved-head { padding: 0 4rpx 18rpx; display: flex; align-items: flex-end; justify-content: space-between; }.saved-head > view { display: flex; flex-direction: column; gap: 5rpx; }.saved-title { color: #2f342f; font-size: 31rpx; font-weight: 700; }.saved-note,.saved-head > text { color: #8a8f88; font-size: 19rpx; }.saved-scroll { width: 100%; }.saved-row { width: max-content; display: flex; gap: 14rpx; }.saved-card { width: 230rpx; overflow: hidden; border: 1rpx solid #e0e3dc; border-radius: 22rpx; background: rgba(255,255,255,.72); }.saved-card image { width: 230rpx; height: 270rpx; }.saved-card > view { padding: 15rpx 16rpx 17rpx; display: flex; flex-direction: column; gap: 5rpx; }.saved-card text:first-child { color: #343934; font-size: 23rpx; font-weight: 650; }.saved-card text:last-child { color: #738069; font-size: 18rpx; }
