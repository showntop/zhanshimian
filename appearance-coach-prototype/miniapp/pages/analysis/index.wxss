.analysis-page { display: flex; flex-direction: column; align-items: center; }
.scan-wrap { position: relative; width: 520rpx; height: 680rpx; margin-top: 30rpx; overflow: hidden; border-radius: 260rpx 260rpx 34rpx 34rpx; background: #e7e8e4; box-shadow: 0 28rpx 80rpx rgba(47,52,45,.12); }
.scan-image { width: 100%; height: 100%; }
.scan-empty { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18rpx; color: #7c8379; font-size: 22rpx; }
.scan-empty image { width: 126rpx; height: 126rpx; opacity: .58; }
.scan-mask { position: absolute; inset: 0; border: 1rpx solid rgba(94,122,73,.25); border-radius: inherit; }
.scan-line { position: absolute; left: 11%; right: 11%; top: 24%; height: 2rpx; background: #6d8d57; box-shadow: 0 0 28rpx 12rpx rgba(105,138,82,.2); animation: scan 2s ease-in-out infinite alternate; }
@keyframes scan { to { transform: translateY(300rpx); } }
.focus-point { position: absolute; width: 14rpx; height: 14rpx; border-radius: 50%; border: 3rpx solid #fff; background: #6f8f59; box-shadow: 0 0 0 8rpx rgba(111,143,89,.16); animation: pulse 1.4s ease-in-out infinite; }
.p1 { top: 27%; left: 36%; }.p2 { top: 27%; right: 36%; animation-delay: .25s; }.p3 { top: 47%; left: 49%; animation-delay: .5s; }
.scan-photo-kind { position: absolute; left: 22rpx; bottom: 22rpx; padding: 8rpx 13rpx; border-radius: 999rpx; background: rgba(255,255,255,.86); color: #587344; font-size: 19rpx; }
@keyframes pulse { 50% { transform: scale(1.28); opacity: .72; } }
.analysis-copy { width: 100%; margin-top: 42rpx; text-align: center; }
.analysis-title { display: block; margin: 18rpx 0 28rpx; font-size: 38rpx; font-weight: 700; }
.progress { height: 7rpx; overflow: hidden; border-radius: 999rpx; background: #e1e2dd; }
.progress-value { height: 100%; border-radius: inherit; background: #587344; transition: width .45s ease; }
.progress-number { display: block; margin-top: 12rpx; color: #747873; font-size: 23rpx; }
.stage-row { margin-top: 30rpx; display: flex; justify-content: space-between; color: #a1a49f; font-size: 22rpx; }
.stage-row .done { color: #587344; font-weight: 600; }
.retry { margin-top: 34rpx; border: 1rpx solid #587344; border-radius: 22rpx; background: transparent; color: #587344; }
